#!/usr/bin/env python3
"""Generate or check the golden fixture for upstream C enum values.

Reads inc/em_base.h from the pinned upstream commit via git, compiles the
six D2 enum blocks with the system C compiler, and writes (or checks) the
fixture at crates/em-types/tests/data/upstream_enums.tsv.

Also validates the hand-maintained classification.tsv against the fixture.
A missing classification file is an error unless --no-classification is given.
"""
# SPDX-License-Identifier: Apache-2.0

import argparse
import difflib
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

PINNED_COMMIT = "ba4180ba36748629f10c20babc4320dd69c9db4f"
HEADER_PATH = "inc/em_base.h"

# (C enum name, expected enumerator count, wire width in hex digits)
ENUMS = [
    ("em_msg_type_t", 72, 4),
    ("em_tlv_type_t", 122, 2),
    ("em_freq_band_t", 5, 2),
    ("em_media_type_t", 10, 4),
    ("em_profile_type_t", 5, 2),
    ("em_service_type_t", 6, 2),
]

FIXTURE_HEADER = (
    "# Generated by tools/gen-upstream-enums. Do not edit by hand.\n"
    "# Source: rdkcentral/unified-wifi-mesh inc/em_base.h"
    f" @ {PINNED_COMMIT}\n"
    "# Regenerate: tools/gen-upstream-enums\n"
    "# Check: tools/gen-upstream-enums --check\n"
    "# SPDX-License-Identifier: Apache-2.0\n"
    "upstream_type\tupstream_identifier\tvalue\n"
)


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def read_header(upstream_path):
    """Read the header from the pinned commit via git."""
    try:
        result = subprocess.run(
            ["git", "--no-replace-objects", "-C", str(upstream_path), "show",
             f"{PINNED_COMMIT}:{HEADER_PATH}"],
            capture_output=True,
        )
    except OSError as exc:
        die(f"error: could not run git: {exc}", 2)
    if result.returncode != 0:
        sys.stderr.buffer.write(result.stderr)
        sys.exit(2)
    try:
        return result.stdout.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        die(f"error: git output is not valid UTF-8: {exc}", 2)


def extract_enums(header, enums=ENUMS):
    """Extract (name, body_text, identifiers) for each enum in enums order.

    The block body is matched with [^{}]* rather than a lazy .*? so that a
    match can never start at an earlier enum and span several blocks: with
    DOTALL, typedef enum {(.*?)} NAME; would begin at the first typedef enum
    in the file and run on until it reached } NAME;.

    Supported C syntax: enumerator identifiers with optional ``= <constant
    expression>``, ``//`` and ``/* */`` comments (including commas inside
    comments), and a trailing comma after the last enumerator.

    Not supported — and guaranteed to fail loudly rather than silently:
    - Braces inside comments: no block matches → exit 1.
    - Preprocessor lines such as ``#if``: the piece is an invalid identifier
      → exit 1.
    - Character literals containing commas (e.g. ``','``): the piece is an
      invalid identifier → exit 1.
    """
    result = []
    for name, expected_count, _width in enums:
        pattern = r"typedef\s+enum\s*\{([^{}]*)\}\s*" + re.escape(name) + r"\s*;"
        matches = re.findall(pattern, header, re.DOTALL)
        if len(matches) != 1:
            die(
                f"error: enum {name}: expected exactly 1 match, found {len(matches)}",
                1,
            )
        body = matches[0]
        # Strip comments before splitting on commas
        body_stripped = re.sub(r"//[^\n]*|/\*.*?\*/", " ", body, flags=re.S)
        pieces = body_stripped.split(",")
        identifiers = []
        for piece in pieces:
            piece = piece.strip()
            if not piece:
                continue
            ident = piece.split("=")[0].strip()
            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", ident):
                die(
                    f"error: enum {name}: invalid identifier {ident!r}",
                    1,
                )
            identifiers.append(ident)
        if len(identifiers) != expected_count:
            die(
                f"error: enum {name}: expected {expected_count} enumerators,"
                f" found {len(identifiers)}",
                1,
            )
        if len(set(identifiers)) != len(identifiers):
            die(f"error: enum {name}: duplicate identifiers", 1)
        result.append((name, body, identifiers))
    return result


def compile_and_run(enum_data, cc):
    """Compile a C program that prints enum values, return its stdout."""
    lines = ["#include <stdio.h>"]
    for name, body, _identifiers in enum_data:
        lines.append(f"typedef enum {{{body}}} {name};")
    lines.append("int main(void) {")
    for name, _body, identifiers in enum_data:
        for ident in identifiers:
            lines.append(
                f'    printf("%s\\t%s\\t%lld\\n",'
                f' "{name}", "{ident}", (long long)({ident}));'
            )
    lines.append("    return 0;")
    lines.append("}")
    src_code = "\n".join(lines) + "\n"

    with tempfile.TemporaryDirectory() as tmpdir:
        src = os.path.join(tmpdir, "enums.c")
        prog = os.path.join(tmpdir, "enums")
        with open(src, "w", encoding="utf-8") as fh:
            fh.write(src_code)
        try:
            result = subprocess.run(
                [cc, "-std=c99", "-Wall", "-Werror", "-o", prog, src],
                capture_output=True,
            )
        except OSError as exc:
            die(f"error: could not run compiler {cc!r}: {exc}", 2)
        if result.returncode != 0:
            sys.stderr.buffer.write(result.stderr)
            sys.exit(2)
        try:
            run = subprocess.run([prog], capture_output=True)
        except OSError as exc:
            die(f"error: could not run compiled program: {exc}", 2)
        if run.returncode != 0:
            sys.stderr.buffer.write(run.stderr)
            sys.exit(2)
        try:
            return run.stdout.decode("utf-8", errors="strict")
        except UnicodeDecodeError as exc:
            die(f"error: compiler program output is not valid UTF-8: {exc}", 2)


def parse_output(output, enum_data, enums=ENUMS):
    """Parse program output into fixture rows, validate ranges and completeness."""
    # Build width lookup
    width_map = {name: width for name, _expected, width in enums}
    # Build expected sequence: (c_name, ident) in declaration order
    expected = [(name, ident) for name, _body, idents in enum_data for ident in idents]

    # Parse all lines from output
    lines = output.split("\n")
    if lines and lines[-1] == "":
        lines = lines[:-1]

    rows = []
    parsed_pairs = []
    for line in lines:
        parts = line.split("\t")
        if len(parts) != 3:
            die(f"error: unexpected output line: {line!r}", 2)
        c_name, ident, val_str = parts
        try:
            val = int(val_str)
        except ValueError:
            die(f"error: non-integer value in output: {val_str!r}", 2)
        if c_name not in width_map:
            die(f"error: unknown enum name in output: {c_name!r}", 2)
        width = width_map[c_name]
        if val < 0 or val >= 16 ** width:
            die(
                f"error: {c_name}::{ident} value {val} out of range"
                f" for {width}-hex-digit field",
                1,
            )
        hex_val = f"0x{val:0{width}X}"
        rows.append((c_name, ident, hex_val))
        parsed_pairs.append((c_name, ident))

    # Completeness check: must match expected sequence exactly
    if parsed_pairs != expected:
        exp_count = len(expected)
        got_count = len(parsed_pairs)
        # Find first differing index
        first_diff = None
        for i in range(max(exp_count, got_count)):
            exp_item = expected[i] if i < exp_count else "extra"
            got_item = parsed_pairs[i] if i < got_count else "missing"
            if exp_item != got_item:
                first_diff = (i, exp_item, got_item)
                break
        if first_diff is not None:
            idx, exp_item, got_item = first_diff
            die(
                f"error: output completeness check failed:"
                f" expected {exp_count} rows, got {got_count};"
                f" first difference at index {idx}:"
                f" expected {exp_item!r}, got {got_item!r}",
                2,
            )
        else:
            die(
                f"error: output completeness check failed:"
                f" expected {exp_count} rows, got {got_count}",
                2,
            )

    return rows


def build_fixture(rows):
    """Build the complete fixture text."""
    data_lines = "".join(
        f"{c_name}\t{ident}\t{hex_val}\n"
        for c_name, ident, hex_val in rows
    )
    return FIXTURE_HEADER + data_lines


def validate_classification(cls_path, rows, check_mode):
    """Validate classification.tsv against fixture rows.

    Returns list of error strings (empty = all good), or None if file is
    missing (caller treats this as an error).
    """
    errors = []

    # F: use try/except instead of exists() to avoid TOCTOU and PermissionError
    try:
        raw = cls_path.read_bytes()
    except FileNotFoundError:
        return None  # signal: file missing
    except OSError as exc:
        die(f"error: cannot read classification file: {exc}", 2)

    # UTF-8 check (a non-UTF-8 classification file is a content error → exit 1)
    try:
        text = raw.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        errors.append(f"classification: not valid UTF-8: {exc}")
        return errors

    # No CR
    if "\r" in text:
        errors.append("classification: contains \\r (Windows line endings not allowed)")

    # Ends with newline
    if not text.endswith("\n"):
        errors.append("classification: does not end with \\n")

    if errors:
        return errors

    all_lines = text.split("\n")
    # Remove trailing empty string from final \n
    if all_lines and all_lines[-1] == "":
        all_lines = all_lines[:-1]

    if not all_lines:
        errors.append("classification: file is empty")
        return errors

    # Header line (line 1)
    expected_header = "upstream_type\tupstream_identifier\tclass\trust_name\tspec_reference\treason"
    if all_lines[0] != expected_header:
        errors.append(
            f"classification: first line must be exactly:\n"
            f"  {expected_header!r}\n"
            f"  got: {all_lines[0]!r}"
        )

    data_lines = all_lines[1:]

    # No blank lines, no comment lines
    # G: use real 1-based source line number (header is line 1)
    for i, line in enumerate(data_lines, start=2):
        if line == "":
            errors.append(f"classification: blank line at line {i}")
        if line.startswith("#"):
            errors.append(f"classification: comment lines not allowed (line {i})")

    # Parse each row; store (lineno, row_data_or_None) to track real line numbers
    cls_rows = []  # list of (lineno, row_tuple_or_None)
    for i, line in enumerate(data_lines, start=2):
        if line == "" or line.startswith("#"):
            continue
        fields = line.split("\t")
        if len(fields) != 6:
            errors.append(
                f"classification: line {i}: expected 6 tab-separated fields,"
                f" got {len(fields)}: {line!r}"
            )
            cls_rows.append((i, None))
            continue
        upstream_type, upstream_ident, cls, rust_name, spec_ref, reason = fields
        row_errors = []

        # G: empty or surrounding-whitespace check
        for fname, fval in [
            ("upstream_type", upstream_type),
            ("upstream_identifier", upstream_ident),
            ("class", cls),
            ("rust_name", rust_name),
            ("spec_reference", spec_ref),
            ("reason", reason),
        ]:
            if not fval or fval != fval.strip():
                row_errors.append(f"field {fname!r} is empty or has surrounding whitespace")

        # class value
        valid_classes = {"spec", "vendor", "internal", "sentinel"}
        if cls not in valid_classes:
            row_errors.append(f"invalid class {cls!r} (must be one of {sorted(valid_classes)})")

        # rust_name rules
        if cls in ("internal", "sentinel"):
            if rust_name != "-":
                row_errors.append(
                    f"rust_name must be '-' for class {cls!r}, got {rust_name!r}"
                )
        else:
            if not re.match(r"^[A-Z][A-Z0-9_]*$", rust_name):
                row_errors.append(
                    f"rust_name {rust_name!r} must match ^[A-Z][A-Z0-9_]*$"
                    f" for class {cls!r}"
                )

        # spec_reference rules
        if cls == "spec":
            if spec_ref == "-":
                row_errors.append("spec_reference must not be '-' for class 'spec'")
        else:
            if spec_ref != "-":
                row_errors.append(
                    f"spec_reference must be '-' for class {cls!r}, got {spec_ref!r}"
                )

        # reason rules
        if cls == "spec":
            if reason != "-":
                row_errors.append(f"reason must be '-' for class 'spec', got {reason!r}")
        else:
            if reason == "-":
                row_errors.append(f"reason must not be '-' for class {cls!r}")

        if row_errors:
            for e in row_errors:
                errors.append(f"classification: line {i} ({upstream_type}/{upstream_ident}): {e}")
            cls_rows.append((i, None))
        else:
            cls_rows.append((i, (upstream_type, upstream_ident, cls, rust_name, spec_ref, reason)))

    # Uniqueness checks (run even when there are row-level errors)
    seen_pairs = {}
    seen_rust = {}
    for lineno, row in cls_rows:
        if row is None:
            continue
        upstream_type, upstream_ident, cls, rust_name, spec_ref, reason = row
        pair = (upstream_type, upstream_ident)
        if pair in seen_pairs:
            errors.append(
                f"classification: duplicate (upstream_type, upstream_identifier) pair:"
                f" {pair} at lines {seen_pairs[pair]} and {lineno}"
            )
        else:
            seen_pairs[pair] = lineno
        if rust_name != "-":
            rkey = (upstream_type, rust_name)
            if rkey in seen_rust:
                errors.append(
                    f"classification: duplicate (upstream_type, rust_name) pair:"
                    f" {rkey} at lines {seen_rust[rkey]} and {lineno}"
                )
            else:
                seen_rust[rkey] = lineno

    # G: if any errors found so far, skip coverage/order and append sentinel
    if errors:
        errors.append(
            "classification: coverage/order check skipped because of the errors above"
        )
        return errors

    # Coverage check: must match fixture rows in order
    fixture_pairs = [(r[0], r[1]) for r in rows]
    cls_pairs = [(row[0], row[1]) for _lineno, row in cls_rows if row is not None]

    fixture_set = set(fixture_pairs)
    cls_set = set(cls_pairs)

    missing = fixture_set - cls_set
    extra = cls_set - fixture_set
    if missing:
        for pair in sorted(missing):
            errors.append(
                f"classification: missing entry for fixture pair {pair}"
            )
    if extra:
        for pair in sorted(extra):
            errors.append(
                f"classification: extra entry not in fixture: {pair}"
            )

    if not missing and not extra:
        # Check order
        for idx, (fp, cp) in enumerate(zip(fixture_pairs, cls_pairs)):
            if fp != cp:
                errors.append(
                    f"classification: order mismatch at index {idx}:"
                    f" fixture has {fp}, classification has {cp}"
                )
                break

    return errors


def main():
    script_dir = Path(__file__).resolve().parent
    repo_root = script_dir.parent
    default_upstream = repo_root.parent / "unified-wifi-mesh"
    default_out = repo_root / "crates/em-types/tests/data/upstream_enums.tsv"
    default_cls = repo_root / "crates/em-types/tests/data/classification.tsv"

    parser = argparse.ArgumentParser(
        description="Generate or check the upstream enum golden fixture."
    )
    parser.add_argument(
        "--upstream",
        type=Path,
        default=default_upstream,
        metavar="PATH",
        help=f"Path to upstream unified-wifi-mesh checkout (default: {default_upstream})",
    )
    parser.add_argument(
        "--out",
        type=Path,
        default=default_out,
        metavar="PATH",
        help=f"Output fixture path (default: {default_out})",
    )
    parser.add_argument(
        "--classification",
        type=Path,
        default=default_cls,
        metavar="PATH",
        help=f"Classification TSV path (default: {default_cls})",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check mode: regenerate and compare, do not write",
    )
    parser.add_argument(
        "--no-classification",
        action="store_true",
        help="Skip classification validation entirely (use when bumping the pinned commit"
             " before the classification has been updated)",
    )
    parser.add_argument(
        "--cc",
        default=os.environ.get("CC", "cc"),
        metavar="COMPILER",
        help="C compiler to use (default: $CC or cc)",
    )
    args = parser.parse_args()

    # Step 1: read header from git
    header = read_header(args.upstream)

    # Step 2: extract enums
    enum_data = extract_enums(header)

    # Step 3: compile and run
    output = compile_and_run(enum_data, args.cc)

    # Step 4: parse output and validate ranges
    rows = parse_output(output, enum_data)

    # Step 5: build fixture text
    fixture_text = build_fixture(rows)
    fixture_bytes = fixture_text.encode("utf-8")

    # Step 6: validate classification (before writing/comparing the fixture)
    cls_summary = ""
    if args.no_classification:
        cls_summary = "skipped"
    else:
        cls_errors = validate_classification(args.classification, rows, args.check)
        if cls_errors is None:
            # File missing — error in both generate and check mode
            print(
                f"error: classification file not found: {args.classification}",
                file=sys.stderr,
            )
            sys.exit(1)
        elif cls_errors:
            for e in cls_errors:
                print(e, file=sys.stderr)
            sys.exit(1)
        else:
            cls_summary = f"{len(rows)} rows validated"

    # Step 7: write or check the fixture
    if args.check:
        if not args.out.exists():
            print(f"error: fixture file not found: {args.out}", file=sys.stderr)
            sys.exit(1)
        try:
            existing_bytes = args.out.read_bytes()
        except OSError as exc:
            die(f"error: cannot read fixture file: {exc}", 2)
        if existing_bytes != fixture_bytes:
            existing_lines = existing_bytes.decode("utf-8", errors="replace").splitlines(keepends=True)
            generated_lines = fixture_text.splitlines(keepends=True)
            diff = difflib.unified_diff(
                existing_lines,
                generated_lines,
                fromfile=str(args.out),
                tofile="<generated>",
            )
            sys.stdout.writelines(diff)
            sys.exit(1)
    else:
        try:
            args.out.parent.mkdir(parents=True, exist_ok=True)
            args.out.write_bytes(fixture_bytes)
        except OSError as exc:
            die(f"error: cannot write fixture file: {exc}", 2)

    # Step 8: success summary
    total = len(rows)
    n_enums = len(ENUMS)
    print(f"ok: {total} enumerators from {n_enums} enums; classification: {cls_summary}")


if __name__ == "__main__":
    main()
