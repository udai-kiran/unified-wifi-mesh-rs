class ContentError(Exception):
    pass


class InputError(Exception):
    pass


def fail(message):
    raise ContentError(message)


def read_git(directory, revision, path):
    try:
        result = subprocess.run(
            ["git", "-C", str(directory), "show", f"{revision}:{path}"],
            check=False, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
    except OSError as exc:
        raise InputError(f"cannot run git: {exc}") from exc
    if result.returncode:
        raise InputError(f"git show {revision}:{path}: {result.stderr.decode(errors='replace').strip()}")
    try:
        return result.stdout.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ContentError(f"{path}: not UTF-8") from exc


def clean(text, mask_literals=False):
    """Mask comments and, for structural scanning only, literals; preserve offsets."""
    if re.search(r"\?\?[=/'()!<>-]|\r(?!\n)", text):
        fail("trigraph or bare carriage return is unsupported")
    if re.search(r"\\\r?\n", text):
        # Only continued preprocessor directives are relevant in these headers.
        lines = text.splitlines(keepends=True)
        in_define = False
        for line in lines:
            if re.match(r"\s*#\s*define\b", line):
                in_define = True
            if re.search(r"\\\r?\n$", line) and not in_define:
                fail("line splice outside a define is unsupported")
            in_define = in_define and bool(re.search(r"\\\r?\n$", line))
    chars = list(text)
    i = 0
    while i < len(text):
        if text.startswith("//", i):
            end = text.find("\n", i)
            end = len(text) if end < 0 else end
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            if end < 0:
                fail("unterminated comment")
            end += 2
        elif text[i] in "\"'":
            quote = text[i]
            end = i + 1
            while end < len(text) and text[end] != quote:
                if text[end] == "\\":
                    end += 1
                end += 1
            if end >= len(text):
                fail("unterminated literal")
            end += 1
            if not mask_literals:
                i = end
                continue
        else:
            i += 1
            continue
        for n in range(i, end):
            if chars[n] not in "\r\n":
                chars[n] = " "
        i = end
    return "".join(chars)


def norm(text):
    return " ".join(text.split())


@dataclass(frozen=True)
class Declaration:
    name: str
    kind: str
    body: str
    definition: str
    source: str
    line: int
    body_line: int
    raw: str


class Source:
    def __init__(self, text, source):
        self.text, self.source = text, source
        self.code = clean(text)
        self.declarations = {}
        self.constants = {}
        self.macro_events = {}
        self.contexts = {}
        self._scan()

    def add(self, decl):
        self.declarations.setdefault(decl.name, []).append(decl)

    def _scan(self):
        code = clean(self.text, mask_literals=True)
        stack = []
        for number, line in enumerate(code.splitlines(), 1):
            self.contexts[number] = tuple(stack)
            directive = re.match(r"\s*#\s*(if|ifdef|ifndef|elif|else|endif)\b(.*)", line)
            if directive:
                op, condition = directive.group(1), directive.group(2).strip()
                if op in ("if", "ifdef", "ifndef"):
                    stack.append((op, condition))
                elif not stack:
                    fail(f"{self.source}:{number}: unbalanced preprocessor conditional")
                elif op == "endif":
                    stack.pop()
                else:
                    stack[-1] = (op, condition)
        if stack:
            fail(f"{self.source}: unclosed preprocessor conditional")
        # Mask directives so their contents cannot create declarations; retain
        # their definitions for lazy integer-expression evaluation.
        for number, line in enumerate(self.code.splitlines(), 1):
            directive = re.match(r"^[ \t]*#[ \t]*(define|undef)[ \t]+([A-Za-z_]\w*)([^\n]*)", line)
            if not directive:
                continue
            operation, name, remainder = directive.groups()
            function_like = remainder.startswith("(")
            self.macro_events.setdefault(name, []).append(
                (operation, number, remainder.strip(), function_like))
            # A function-like macro has no whitespace after its name.
            if operation == "define" and not function_like:
                self.constants.setdefault(name, []).append((remainder.strip(), number))
        code = re.sub(r"(?m)^[ \t]*#.*(?:\\\r?\n.*)*", lambda m: re.sub(r"[^\r\n]", " ", m.group()), code)
        occupied = []
        pattern = r"\btypedef\s+(struct|enum|union)\s*(?:[A-Za-z_]\w*\s*)?\{"
        for match in re.finditer(pattern, code):
            if any(a <= match.start() < b for a, b in occupied):
                continue
            depth, pos = 1, match.end()
            while pos < len(code) and depth:
                if code[pos] == "{":
                    depth += 1
                elif code[pos] == "}":
                    depth -= 1
                pos += 1
            if depth:
                fail(f"{self.source}: unclosed {match.group(1)}")
            end = code.find(";", pos)
            if end < 0:
                fail(f"{self.source}: missing typedef terminator")
            trailer = code[pos:end].strip()
            trailer = re.sub(r"__attribute__\s*\(\(\s*(?:__packed__|packed)\s*\)\)", " ", trailer)
            trailer_match = re.fullmatch(r"\s*([A-Za-z_]\w*)\s*", trailer)
            if trailer_match:
                name = trailer_match.group(1)
                line = code.count("\n", 0, match.start()) + 1
                body_line = code.count("\n", 0, match.end()) + 1
                # Use the unmasked code here: a directive inside a reachable
                # declaration must fail, not disappear before field parsing.
                body = self.code[match.end():pos - 1]
                raw = self.code[match.start():end + 1]
                self.add(Declaration(name, match.group(1), body,
                                     norm(raw), self.source, line, body_line, raw))
            occupied.append((match.start(), end + 1))
        mask = list(code)
        for start, end in occupied:
            for n in range(start, end):
                if mask[n] not in "\r\n":
                    mask[n] = " "
        rest = "".join(mask)
        for match in re.finditer(r"\btypedef\s+([^;{}]+);", rest):
            body = norm(match.group(1))
            # Unsupported aliases are not reachable until explicitly named.
            try:
                typ, name, bounds, pointer, bit = parse_declarator(body)
            except ContentError:
                continue
            if bit:
                continue
            line = rest.count("\n", 0, match.start()) + 1
            raw = self.code[match.start():match.end()]
            raw_body = self.code[match.start(1):match.end(1)]
            self.add(Declaration(name, "alias", norm(raw_body), norm(raw), self.source, line, line, raw))

    def get(self, name):
        found = self.declarations.get(name, [])
        if len(found) > 1:
            fail(f"{self.source}: duplicate declaration {name}")
        return found[0] if found else None

    def assert_context(self, line, guarded_macro=None):
        guard = HEADER_GUARDS.get(self.source)
        expected = (("ifndef", guard),) if guard else ()
        if guarded_macro:
            expected += (("ifndef", guarded_macro),)
        actual = self.contexts.get(line)
        if actual != expected:
            fail(f"{self.source}:{line}: unsupported conditional context {actual}; expected {expected}")

    def assert_declaration(self, decl):
        if re.search(r"(?m)^[ \t]*#", decl.raw):
            fail(f"{decl.source}:{decl.line}: directive inside reached declaration {decl.name}")
        if re.search(r"[\"']", decl.raw):
            fail(f"{decl.source}:{decl.line}: literal inside reached declaration {decl.name}")


def parse_declarator(statement):
    statement = norm(statement)
    m = re.fullmatch(
        r"(.+?)(?:\s+|(?=\*))((?:\*\s*)*)([A-Za-z_]\w*)\s*((?:\[[^\[\]]+\]\s*)*)(?:\:\s*(.+))?",
        statement,
    )
    if not m:
        fail(f"unsupported or malformed field/alias: {statement!r}")
    typ, stars, name, dimensions, bit = m.groups()
    typ = norm(typ)
    if name in {"auto", "break", "case", "char", "const", "continue", "default", "do", "double", "else",
                "enum", "extern", "float", "for", "goto", "if", "inline", "int", "long", "register",
                "restrict", "return", "short", "signed", "sizeof", "static", "struct", "switch", "typedef",
                "union", "unsigned", "void", "volatile", "while", "_Bool"}:
        fail(f"missing or invalid field/alias name in {statement!r}")
    if not re.fullmatch(r"(?:const\s+|volatile\s+)*(?:[A-Za-z_]\w*)(?:\s+[A-Za-z_]\w*)*", typ):
        fail(f"unsupported field type in {statement!r}")
    bounds = re.findall(r"\[([^\[\]]+)\]", dimensions)
    if bit and (bounds or stars):
        fail(f"unsupported bit-field declaration {statement!r}")
    return typ, name, bounds, len(stars.replace(" ", "")), bit


def canonical_type(typ):
    return norm(re.sub(r"\b(?:const|volatile)\b", " ", typ))


def parse_fields(decl):
    if re.search(r"[{}#]", decl.body):
        fail(f"{decl.source}:{decl.line}: unsupported nested/conditional aggregate {decl.name}")
    parts = decl.body.split(";")
    if parts[-1].strip():
        fail(f"{decl.source}:{decl.line}: missing field terminator in {decl.name}")
    fields, seen = [], set()
    offset = 0
    for part in parts[:-1]:
        leading = len(part) - len(part.lstrip())
        line = decl.body_line + decl.body.count("\n", 0, offset + leading)
        offset += len(part) + 1
        if not part.strip():
            fail(f"{decl.source}:{line}: empty field in {decl.name}")
        typ, name, bounds, pointer, bit = parse_declarator(part)
        if name in seen:
            fail(f"{decl.source}:{line}: duplicate field {decl.name}.{name}")
        seen.add(name)
        fields.append((typ, name, bounds, pointer, bit, line))
    if not fields:
        fail(f"{decl.source}:{decl.line}: empty aggregate {decl.name}")
    return fields


OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
       ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.LShift: operator.lshift,
       ast.RShift: operator.rshift, ast.BitOr: operator.or_, ast.BitAnd: operator.and_,
       ast.BitXor: operator.xor}


def evaluate(expr, lookup):
    expr = norm(expr)
    if re.search(r"[\"']", expr):
        fail(f"literal in integer expression {expr!r}")
    # C integer suffixes and octal literals; casts and other syntax are rejected.
    expr = re.sub(r"\b(0[xX][0-9a-fA-F]+|[0-9]+)[uUlL]+\b", r"\1", expr)
    expr = re.sub(r"\b0([0-7]+)\b", r"0o\1", expr)
    expr = re.sub(r"(?<!/)/(?!/)", "//", expr)
    try:
        root = ast.parse(expr, mode="eval").body
    except (SyntaxError, ValueError) as exc:
        raise ContentError(f"invalid integer expression {expr!r}") from exc

    def bounded(value):
        # Keeping every intermediate in this range makes signed/unsigned C
        # integer promotions agree with Python's unbounded arithmetic.
        if not 0 <= value <= 0x7fffffff:
            fail(f"integer expression outside supported nonnegative int range: {expr!r}")
        return value

    def visit(node):
        if isinstance(node, ast.Constant) and type(node.value) is int:
            return bounded(node.value)
        if isinstance(node, ast.Name):
            return bounded(lookup(node.id))
        if isinstance(node, ast.BinOp) and type(node.op) in OPS:
            a, b = visit(node.left), visit(node.right)
            if isinstance(node.op, (ast.FloorDiv, ast.Mod)) and (a < 0 or b <= 0):
                fail(f"unsupported signed division in {expr!r}")
            if isinstance(node.op, (ast.LShift, ast.RShift)) and (b < 0 or b > 63):
                fail(f"invalid shift in {expr!r}")
            return bounded(OPS[type(node.op)](a, b))
        if isinstance(node, ast.UnaryOp) and type(node.op) in (ast.UAdd, ast.USub):
            v = visit(node.operand)
            return bounded(v if isinstance(node.op, ast.UAdd) else -v)
        fail(f"unsupported integer expression {expr!r}")
    try:
        return visit(root)
    except (ArithmeticError, OverflowError) as exc:
        raise ContentError(f"invalid integer expression {expr!r}: {exc}") from exc


def parse_enum(decl):
    if re.search(r"[{}#;]", decl.body):
        fail(f"{decl.source}:{decl.line}: unsupported enum {decl.name}")
    parts = decl.body.split(",")
    if not parts[-1].strip():
        parts.pop()
    result, seen = [], set()
    for part in parts:
        m = re.fullmatch(r"\s*([A-Za-z_]\w*)\s*(?:=\s*(.+?))?\s*", part, re.S)
        if not m:
            fail(f"{decl.source}:{decl.line}: malformed enum {decl.name}: {part!r}")
        name, expr = m.group(1), m.group(2)
        if name in seen:
            fail(f"{decl.source}:{decl.line}: duplicate enumerator {name}")
        seen.add(name)
        result.append((name, norm(expr) if expr else None))
    if not result:
        fail(f"{decl.source}:{decl.line}: empty enum {decl.name}")
    return result


def validate_macro_replacement(name, replacement, entire_bound=False):
    """Reject substitutions whose standalone value may alter C precedence."""
    replacement = replacement.strip()
    integer = r"(?:0[xX][0-9a-fA-F]+|[0-9]+)(?:[uU](?:ll|LL|l|L)?|(?:ll|LL|l|L)[uU]?)?"
    if re.search(r"[\"']", replacement):
        fail(f"literal in replacement for macro {name}")
    # Python treats '#' as a comment, underscores as digit separators, and
    # adjacent '+' signs as two operators. None is safe to accept as C here.
    if re.search(r"\+\+|--", replacement):
        fail(f"unsupported replacement for macro {name}: {replacement!r}")
    token = rf"(?:{integer}(?![A-Za-z0-9_])|[A-Za-z_]\w*|<<|>>|[()+\-*/%|&^])"
    if not re.fullmatch(rf"(?:\s*{token})+\s*", replacement):
        fail(f"unsupported replacement for macro {name}: {replacement!r}")
    if re.fullmatch(rf"(?:{integer}|[A-Za-z_]\w*)", replacement):
        return
    if replacement.startswith("(") and replacement.endswith(")"):
        depth = 0
        for index, char in enumerate(replacement):
            if char == "(":
                depth += 1
            elif char == ")":
                depth -= 1
                if depth < 0 or (depth == 0 and index != len(replacement) - 1):
                    break
        else:
            if depth == 0:
                return
    if entire_bound:
        return
    fail(f"unsupported replacement for macro {name}: {replacement!r}")


def read_tsv(path, columns):
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise ContentError(f"required file missing: {path}") from exc
    except UnicodeDecodeError as exc:
        raise ContentError(f"{path}: not UTF-8") from exc
    except OSError as exc:
        raise InputError(f"cannot read {path}: {exc}") from exc
    lines = [line for line in text.splitlines() if not line.startswith("#")]
    try:
        reader = csv.DictReader(lines, delimiter="\t", strict=True)
        if tuple(reader.fieldnames or ()) != columns:
            fail(f"{path}: expected columns {columns}")
        rows = list(reader)
    except csv.Error as exc:
        raise ContentError(f"{path}: malformed TSV: {exc}") from exc
    for row in rows:
        if None in row or any(value is None or not value.strip() for value in row.values()):
            fail(f"{path}: missing or extra column")
    return rows


def validate_manifest(rows, sources):
    result = {}
    for row in rows:
        name, kind = row["name"], row["kind"]
        if name in result:
            fail(f"manifest: duplicate {name}")
        if kind == "abi":
            expected = ABI.get(name)
            actual = (row["definition"], row["revision"], row["source"])
            if row["repository"] != "platform" or row["commit_date"] != "-" or actual != expected:
                fail(f"manifest: invalid ABI mapping for {name}")
        else:
            repo = row["repository"]
            if repo not in PINS or (row["revision"], row["commit_date"]) != PINS[repo]:
                fail(f"manifest: invalid pin for {name}")
            try:
                path, line = row["source"].rsplit(":", 1)
                src = sources[(repo, path)]
                line = int(line)
            except (ValueError, KeyError):
                fail(f"manifest: unknown source for {name}: {row['source']}")
            if kind in ("alias", "struct", "enum"):
                decl = src.get(name)
                if not decl or decl.kind != kind or decl.line != line or decl.definition != row["definition"]:
                    fail(f"manifest: {name} does not match pinned declaration at {row['source']}")
                src.assert_context(line)
                src.assert_declaration(decl)
            elif kind in ("constant", "type-macro"):
                definitions = src.constants.get(name, [])
                if (row["definition"], line) not in definitions:
                    fail(f"manifest: {name} does not match pinned macro at {row['source']}")
                src.assert_context(line, name if kind == "type-macro" else None)
            else:
                fail(f"manifest: unknown kind {kind}")
        result[name] = row
    return result


class Walker:
    def __init__(self, base, sources, manifest):
        self.base, self.sources, self.manifest = base, sources, manifest
        self.reached, self.rows, self.used_external = {}, [], set()
        self.constants, self.resolving, self.enum_values = {}, set(), {}
        self.enum_owners = {}
        self.enumerators = {}
        self.macro_events = {}
        self.macro_replacements = {}
        self.duplicate_macros = {}
        source_entries = [("unified-wifi-mesh", base)] + [(key[0], source) for key, source in sources.items()]
        for repo, source in source_entries:
            for name, events in source.macro_events.items():
                self.macro_events.setdefault(name, []).extend(
                    (repo, source.source, op, line, replacement, function_like)
                    for op, line, replacement, function_like in events)
            for candidates in source.declarations.values():
                for decl in candidates:
                    if decl.kind != "enum":
                        continue
                    try:
                        values = parse_enum(decl)
                    except ContentError:
                        continue  # An unvisited enum is not part of the contract.
                    for name, _ in values:
                        self.enumerators.setdefault(name, []).append(decl)

    def external(self, name):
        row = self.manifest.get(name)
        if row is None:
            fail(f"unresolved type or external absent from manifest: {name}")
        self.used_external.add(name)
        if row["kind"] == "abi":
            return row, None
        path = row["source"].rsplit(":", 1)[0]
        return row, self.sources[(row["repository"], path)].get(name)

    def assert_macro(self, name):
        events = self.macro_events.get(name, [])
        if any(op == "undef" for _, _, op, _, _, _ in events):
            fail(f"macro {name} is undefined in read sources: {events}")
        definitions = [event for event in events if event[2] == "define"]
        if any(replacement.endswith("\\") for _, _, _, _, replacement, _ in definitions):
            fail(f"continued definition of macro {name} is unsupported")
        # C11 6.10.3p2 requires the same tokens and whitespace separation;
        # comments have already been masked and whitespace runs are normalized.
        forms = {(norm(replacement), function_like) for _, _, _, _, replacement, function_like in definitions}
        if len(forms) > 1:
            fail(f"macro {name} has differing redefinitions in read sources: {definitions}")
        if len(definitions) > 1:
            self.duplicate_macros[name] = [f"{repo}:{path}:{line}"
                                           for repo, path, _, line, _, _ in definitions]

    def eval_macro(self, name, replacement, entire_bound=False):
        validate_macro_replacement(name, replacement, entire_bound)
        try:
            return evaluate(replacement, self.lookup)
        except ContentError as exc:
            raise ContentError(f"macro {name}: {exc}") from exc

    def lookup(self, name, entire_bound=False):
        self.assert_macro(name)
        # A cached value may have first been used as an entire bound. Recheck
        # its replacement in every later context before using that value.
        if name in self.macro_replacements:
            validate_macro_replacement(name, self.macro_replacements[name], entire_bound)
        if name in self.constants:
            return self.constants[name]
        if name in self.resolving:
            fail(f"recursive constant {name}")
        self.resolving.add(name)
        try:
            choices = self.base.constants.get(name, [])
            if choices:
                self.base.assert_context(choices[0][1])
                self.macro_replacements[name] = choices[0][0]
                value = self.eval_macro(name, choices[0][0], entire_bound)
            elif name in self.enumerators:
                declarations = self.enumerators[name]
                if len(declarations) != 1:
                    fail(f"ambiguous enumerator {name}")
                self.walk(declarations[0].name)
                value = self.constants[name]
            else:
                row, _ = self.external(name)
                if row["kind"] != "constant":
                    fail(f"{name} is not an integer constant")
                self.macro_replacements[name] = row["definition"]
                value = self.eval_macro(name, row["definition"], entire_bound)
            self.constants[name] = value
            return value
        finally:
            self.resolving.remove(name)

    def eval_enum(self, decl):
        if decl.name in self.enum_values:
            return self.enum_values[decl.name]
        result, previous = [], -1
        for name, expr in parse_enum(decl):
            value = evaluate(expr, self.lookup) if expr is not None else previous + 1
            if value > 0x7fffffff:
                fail(f"enumerator {name} exceeds supported int range")
            if name in self.enum_owners and self.enum_owners[name] != decl.name:
                fail(f"duplicate enumerator {name}")
            self.enum_owners[name] = decl.name
            if name in self.constants and self.constants[name] != value:
                fail(f"conflicting enumerator {name}")
            self.constants[name] = value
            result.append((name, value))
            previous = value
        self.enum_values[decl.name] = result
        return result

    def add_field(self, owner, typ, name, bounds, pointer, bit, source, last_member=False):
        base_type = canonical_type(typ)
        if not base_type:
            fail(f"{owner}.{name}: missing type")
        values = [evaluate(bound, lambda name: self.lookup(name, entire_bound=norm(bound) == name))
                  for bound in bounds]
        if any(v < 0 for v in values):
            fail(f"{owner}.{name}: negative array bound")
        width = evaluate(bit, self.lookup) if bit else None
        if width is not None and width <= 0:
            fail(f"{owner}.{name}: invalid bit width")
        if width is not None:
            maximum = BIT_FIELD_WIDTHS.get(base_type)
            if maximum is None or width > maximum:
                fail(f"{owner}.{name}: unsupported type or width for bit-field {base_type}:{width}")
        flags = []
        if pointer:
            flags.append("pointer" if pointer == 1 else f"pointer:{pointer}")
        if 0 in values:
            if not last_member or values != [0]:
                fail(f"{owner}.{name}: zero-length array is not a final wire-tail member")
            flags.append("wire-tail")
        if bit:
            flags.append("bit-field")
        decl = self.base.get(base_type)
        row = self.manifest.get(base_type)
        if (decl and decl.kind == "enum") or (row and row["kind"] == "enum"):
            flags.append("enum")
        self.rows.append((owner, name, typ + (" " + "*" * pointer if pointer else ""),
                          ";".join(map(norm, bounds)) or "-", ";".join(map(str, values)) or "-",
                          str(width) if width is not None else "-", ",".join(flags) or "-", "-", source))
        self.walk(base_type)

    def walk(self, name):
        if name in self.reached:
            return
        if name in BUILTINS:
            self.reached[name] = None
            return
        decl = self.base.get(name)
        external_row = None
        if decl is None:
            external_row, decl = self.external(name)
        else:
            self.base.assert_context(decl.line)
        self.reached[name] = decl
        if external_row and external_row["kind"] == "abi":
            mapping_source = ABI_INVENTORY_SOURCE.get(name, external_row["source"])
            self.rows.append((name, "<mapping>", external_row["definition"], "-", "-", "-", "abi", "-", mapping_source))
            return
        if external_row and external_row["kind"] == "type-macro":
            self.assert_macro(name)
            typ = external_row["definition"]
            self.add_field(name, typ, "<mapping>", [], 0, None, external_row["source"])
            return
        if decl is None:
            fail(f"{name}: external is not a type")
        declaration_source = self.base if external_row is None else self.sources[(external_row["repository"], external_row["source"].rsplit(":", 1)[0])]
        declaration_source.assert_declaration(decl)
        source = f"{decl.source}:{decl.line}"
        if decl.kind == "alias":
            typ, alias, bounds, pointer, bit = parse_declarator(decl.body)
            if alias != name:
                fail(f"alias mismatch: {name}")
            self.add_field(name, typ, "<alias>", bounds, pointer, bit, source)
        elif decl.kind == "struct":
            fields = parse_fields(decl)
            for index, (typ, field, bounds, pointer, bit, line) in enumerate(fields):
                self.add_field(name, typ, field, bounds, pointer, bit, f"{decl.source}:{line}",
                               last_member=index == len(fields) - 1)
        elif decl.kind == "enum":
            for symbol, value in self.eval_enum(decl):
                self.rows.append((name, symbol, "enumerator", "-", "-", "-", "enum", str(value), source))
        else:
            fail(f"{source}: unsupported reached declaration kind {decl.kind}")


def coverage_rows(text, moved=None):
    """Return {name: line} for em-dm rows.

    If `moved` is a dict, it is filled with {name: (line, owner)} for every other row, so that a
    type reassigned away from em-dm by the approved type table can still be checked.
    """
    result, seen = {}, set()
    header = ("Line", "Kind", "Upstream type", "Owner", "Note", "Status")
    lines = text.splitlines()
    starts = [i for i, line in enumerate(lines)
              if tuple(cell.strip() for cell in line.strip().strip("|").split("|")) == header]
    if len(starts) != 1:
        fail("coverage: expected exactly one types table header")
    start = starts[0]
    if start + 1 >= len(lines):
        fail("coverage: missing table separator")
    separator = lines[start + 1].strip()
    if not separator.startswith("|") or not separator.endswith("|"):
        fail("coverage: malformed table separator")
    columns = [cell.strip() for cell in separator[1:-1].split("|")]
    if len(columns) != len(header) or any(not re.fullmatch(r":?-{3,}:?", cell) for cell in columns):
        fail("coverage: malformed table separator")
    owner_pattern = r"(?:em-[a-z][a-z0-9-]*|do not port|pending \(\d+\)|deferred \([\w, ]+\)|replaced \(\w+\))"
    for number, raw in enumerate(lines[start + 2:], start + 3):
        line = raw.strip()
        if not line:
            continue
        if line.startswith("#"):
            break
        if not line.startswith("|") or not line.endswith("|"):
            fail(f"coverage:{number}: malformed table row")
        cells = [cell.strip() for cell in line[1:-1].split("|")]
        if len(cells) != len(header):
            fail(f"coverage:{number}: malformed table row")
        line_number, kind, type_cell, owner, note, status = cells
        if owner.startswith("**") and owner.endswith("**") and len(owner) > 4:
            owner = owner[2:-2]
        match = re.fullmatch(r"`([A-Za-z_]\w*)`", type_cell)
        if (not re.fullmatch(r"[1-9]\d*", line_number) or kind not in {"alias", "struct", "enum"}
                or not match or not re.fullmatch(owner_pattern, owner) or not note or not status):
            fail(f"coverage:{number}: malformed table row")
        name = match.group(1)
        if name in seen:
            fail(f"coverage: duplicate {name}")
        seen.add(name)
        if owner == "em-dm":
            result[name] = int(line_number)
        elif moved is not None:
            moved[name] = (int(line_number), owner)
    if not result:
        fail("coverage: no em-dm rows found")
    return result


def validate_classification(rows, walker, coverage, moved=None):
    seen, counts = set(), {category: 0 for category in sorted(CATEGORIES)}
    required = set(walker.reached) | set(coverage)
    moved = moved or {}
    # A row for a type the approved table moved away from em-dm is allowed only if the coverage
    # table already records the same destination and line.
    allowed = {row["type"] for row in rows
               if row["type"] in moved and row["type"] not in walker.reached
               and moved[row["type"]][1] == row["proposed_owner"].strip()
               and row["em_base.h_line"] == str(moved[row["type"]][0])}
    for row in rows:
        name = row["type"]
        if name in seen:
            fail(f"classification: duplicate type {name}")
        seen.add(name)
        if row["category"] not in CATEGORIES:
            fail(f"classification: unknown category {row['category']!r} for {name}")
        if not row["reason"].strip() or row["reason"].strip() == "-":
            fail(f"classification: missing reason for {name}")
        if name in coverage and (not row["proposed_owner"].strip() or row["proposed_owner"].strip() == "-"):
            fail(f"classification: missing reassignment destination for {name}")
        counts[row["category"]] += 1
        decl = walker.base.get(name)
        expected_line = str(decl.line) if decl else "-"
        if row["em_base.h_line"] != expected_line:
            fail(f"classification: wrong em_base.h line for {name}: expected {expected_line}")
        if name in coverage and expected_line != str(coverage[name]):
            fail(f"classification: coverage line mismatch for {name}")
    missing, extra = required - seen, seen - required - allowed
    if missing or extra:
        fail(f"classification: missing {sorted(missing)}; extra {sorted(extra)}")
    return counts


def format_inventory(walker):
    out = io.StringIO(newline="")
    out.write("# Generated by tools/gen-dm-inventory; do not edit.\n")
    out.write(f"# unified-wifi-mesh inc/em_base.h @ {UPSTREAM}; x86_64 Linux LP64\n")
    out.write("# <alias>/<mapping> rows account for typedef and ABI leaves; ';' separates array dimensions.\n")
    out.write("# enum rows carry numerical values; source lines cite declaration starts for enums.\n")
    for name, locations in sorted(walker.duplicate_macros.items()):
        out.write(f"# Identical referenced macro {name}: {', '.join(locations)}\n")
    writer = csv.writer(out, delimiter="\t", lineterminator="\n")
    writer.writerow(INVENTORY_COLUMNS)
    writer.writerows(walker.rows)
    return out.getvalue()


def atomic_write(path, data):
    temp_name = None
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", newline="", dir=path.parent, delete=False) as stream:
            temp_name = stream.name
            os.fchmod(stream.fileno(), 0o644)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp_name, path)
        temp_name = None
    except OSError as exc:
        raise InputError(f"cannot write {path}: {exc}") from exc
    finally:
        if temp_name:
            try:
                os.unlink(temp_name)
            except OSError:
                pass


def run(args):
    paths = {
        ("OneWifi", "include/wifi_base.h"): args.onewifi,
        ("rdkb-halif-wifi", "include/wifi_hal_generic.h"): args.halif,
        ("rdkb-halif-wifi", "include/wifi_hal_extender.h"): args.halif,
        ("rdkb-halif-wifi", "include/wifi_hal_ap.h"): args.halif,
    }
    base = Source(read_git(args.upstream, UPSTREAM, "inc/em_base.h"), "inc/em_base.h")
    sources = {key: Source(read_git(directory, PINS[key[0]][0], key[1]), key[1])
               for key, directory in paths.items()}
    manifest_rows = read_tsv(args.manifest, MANIFEST_COLUMNS)
    cls_rows = read_tsv(args.classification, CLASS_COLUMNS)
    manifest = validate_manifest(manifest_rows, sources)
    walker = Walker(base, sources, manifest)
    for root in ROOTS:
        walker.walk(root)
    unused = set(manifest) - walker.used_external
    if unused:
        fail(f"manifest: unused external dependencies: {sorted(unused)}")
    try:
        moved = {}
        coverage = coverage_rows(args.coverage.read_text(encoding="utf-8"), moved)
    except UnicodeDecodeError as exc:
        raise ContentError("coverage: not UTF-8") from exc
    except OSError as exc:
        raise InputError(f"cannot read coverage: {exc}") from exc
    counts = validate_classification(cls_rows, walker, coverage, moved)
    generated = format_inventory(walker)
    if args.check:
        try:
            existing = args.out.read_bytes()
        except FileNotFoundError as exc:
            raise ContentError(f"inventory missing: {args.out}") from exc
        except OSError as exc:
            raise InputError(f"cannot read inventory: {exc}") from exc
        if existing != generated.encode("utf-8"):
            old = existing.decode("utf-8", errors="replace")
            sys.stdout.writelines(difflib.unified_diff(old.splitlines(keepends=True), generated.splitlines(keepends=True),
                                                       fromfile=str(args.out), tofile="<generated>"))
            fail("inventory fixture is stale")
    else:
        atomic_write(args.out, generated)
    fields = sum(row[1] not in ("<alias>", "<mapping>") and row[2] != "enumerator" for row in walker.rows)
    enums = sum(decl is not None and decl.kind == "enum" for decl in walker.reached.values())
    enumerators = sum(row[2] == "enumerator" for row in walker.rows)
    print(f"ok: {len(ROOTS)} roots, {len(walker.reached)} types, {fields} fields, {enums} enums, "
          f"{enumerators} enumerators, {len(manifest)} externals; classifications: "
          + ", ".join(f"{name}={counts[name]}" for name in sorted(counts)))


def main(argv=None):
    root = Path(__file__).resolve().parent.parent
    data = root / "crates/em-dm/tests/data"
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--upstream", type=Path, default=root.parent / "unified-wifi-mesh")
    parser.add_argument("--onewifi", type=Path, default=root.parent / "OneWifi")
    parser.add_argument("--halif", type=Path, default=root.parent / "rdkb-halif-wifi")
    parser.add_argument("--manifest", type=Path, default=data / "dm_external_manifest.tsv")
    parser.add_argument("--classification", type=Path, default=data / "dm_type_classification.tsv")
    parser.add_argument("--coverage", type=Path, default=root / "docs/em_base-coverage.md")
    parser.add_argument("--out", type=Path, default=data / "dm_inventory.tsv")
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args(argv)
    try:
        run(args)
    except ContentError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except InputError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
