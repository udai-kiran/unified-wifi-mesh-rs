#!/usr/bin/env python3
"""Generate or check the golden fixture for upstream frequency range data.

Reads src/utils/util.cpp from the pinned upstream commit via git and
extracts the frequency_ranges table, writes (or checks) the fixture at
crates/em-utils/tests/data/upstream_freq_ranges.tsv.
"""
# SPDX-License-Identifier: Apache-2.0

import argparse
import difflib
import re
import subprocess
import sys
from pathlib import Path

PINNED_COMMIT = "ba4180ba36748629f10c20babc4320dd69c9db4f"
SOURCE_PATH = "src/utils/util.cpp"

FIXTURE_HEADER = (
    "# Generated by tools/gen-upstream-freq-ranges. Do not edit by hand.\n"
    "# Source: rdkcentral/unified-wifi-mesh src/utils/util.cpp"
    f" @ {PINNED_COMMIT}\n"
    "# Regenerate: tools/gen-upstream-freq-ranges\n"
    "# Check: tools/gen-upstream-freq-ranges --check\n"
    "# SPDX-License-Identifier: Apache-2.0\n"
    "op_class\tmin_chan\tmax_chan\tbase_freq\tspacing\tregion\n"
)

EXPECTED_TOTAL = 68
EXPECTED_COUNTS = {"": 30, "US": 11, "EU": 11, "JP": 9, "CN": 7}

# Integer pattern: decimal only, no leading zeros (010 is octal in C).
_RE_INT = re.compile(r'0|[1-9][0-9]*')
# Whitespace pattern used for anchored skips.
_RE_WS = re.compile(r'\s*')
# The table declaration; any whitespace may separate its tokens.
_RE_DECL = re.compile(
    r"const\s+std\s*::\s*vector\s*<\s*freq_range\s*>\s+frequency_ranges\s*=\s*\{"
)


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def read_source(upstream_path):
    """Read the C++ source from the pinned commit via git."""
    try:
        result = subprocess.run(
            ["git", "--no-replace-objects", "-C", str(upstream_path), "show",
             f"{PINNED_COMMIT}:{SOURCE_PATH}"],
            capture_output=True,
        )
    except OSError as exc:
        die(f"error: could not run git: {exc}", 2)
    if result.returncode != 0:
        sys.stderr.buffer.write(result.stderr)
        sys.exit(2)
    try:
        return result.stdout.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        die(f"error: git output is not valid UTF-8: {exc}", 2)


def strip_comments(source):
    """Remove // and /* */ comments but not inside double-quoted strings.

    Uses a character-by-character state machine. Line comments keep their
    newline; a block comment becomes one space.
    Dies on unterminated strings or block comments (exit 1).
    """
    result = []
    i = 0
    n = len(source)
    while i < n:
        c = source[i]

        if c == '"':
            # String literal: copy verbatim including escape sequences.
            result.append(c)
            i += 1
            closed = False
            while i < n:
                c2 = source[i]
                result.append(c2)
                i += 1
                if c2 == '\\':
                    # Escape sequence: include next char too.
                    if i < n:
                        result.append(source[i])
                        i += 1
                elif c2 == '"':
                    closed = True
                    break
            if not closed:
                die("error: unterminated string literal in source", 1)

        elif source[i:i+2] == '//':
            # Line comment: skip to end of line, keep the newline itself.
            i += 2
            while i < n and source[i] != '\n':
                i += 1

        elif source[i:i+2] == '/*':
            # Block comment: skip to closing */.
            i += 2
            while i < n and source[i:i+2] != '*/':
                i += 1
            if i >= n:
                die("error: unterminated block comment in source", 1)
            i += 2  # skip */
            # A comment separates tokens, like whitespace: 8/**/1 is not 81.
            result.append(" ")

        else:
            result.append(c)
            i += 1

    return ''.join(result)


def _skip_ws(text, pos):
    """Return position after skipping any whitespace at pos."""
    m = _RE_WS.match(text, pos)
    return m.end()


def _parse_entry(body, pos):
    """Parse one vector entry after the opening {.

    Expects: int, int, int, int, int, "REGION" }
    Returns (row_tuple, new_pos) where new_pos is after the closing }.
    """
    n = len(body)
    fields = []
    for _ in range(5):
        pos = _skip_ws(body, pos)
        m = _RE_INT.match(body, pos)
        if not m:
            die(
                f"error: expected integer in freq_range entry,"
                f" got {body[pos:pos+40]!r}",
                1,
            )
        fields.append(int(m.group()))
        pos = m.end()
        pos = _skip_ws(body, pos)
        if pos >= n or body[pos] != ',':
            die(
                f"error: expected ',' after integer in entry,"
                f" got {body[pos:pos+40]!r}",
                1,
            )
        pos += 1

    # Region string.
    pos = _skip_ws(body, pos)
    if pos >= n or body[pos] != '"':
        die(
            f"error: expected quoted region string in entry,"
            f" got {body[pos:pos+40]!r}",
            1,
        )
    pos += 1
    end = body.find('"', pos)
    if end == -1:
        die("error: unterminated region string in entry", 1)
    region = body[pos:end]
    pos = end + 1

    pos = _skip_ws(body, pos)
    if pos >= n or body[pos] != '}':
        die(
            f"error: expected '}}' to close entry,"
            f" got {body[pos:pos+40]!r}",
            1,
        )
    pos += 1

    op_class, min_chan, max_chan, base_freq, spacing = fields
    return (op_class, min_chan, max_chan, base_freq, spacing, region), pos


def _parse_body(body):
    """Parse the body of the vector initializer strictly.

    Returns a list of row tuples. Dies (exit 1) on any unexpected text.
    """
    pos = 0
    rows = []
    n = len(body)

    while True:
        pos = _skip_ws(body, pos)
        if pos >= n:
            break

        c = body[pos]
        if c != '{':
            die(
                f"error: unexpected text in frequency_ranges body:"
                f" {body[pos:pos+40]!r}",
                1,
            )

        pos += 1
        row, pos = _parse_entry(body, pos)
        rows.append(row)

        pos = _skip_ws(body, pos)
        if pos >= n:
            break

        c = body[pos]
        if c == ',':
            pos += 1
        else:
            die(
                f"error: unexpected text after entry in frequency_ranges:"
                f" {body[pos:pos+40]!r}",
                1,
            )

    return rows


def extract(source):
    """Extract freq_range rows from C++ source.

    Returns a list of (op_class, min_chan, max_chan, base_freq, spacing, region)
    tuples in table order. Dies on structural errors (exit 1).
    """
    stripped = strip_comments(source)

    matches = list(_RE_DECL.finditer(stripped))
    count = len(matches)
    if count == 0:
        die("error: frequency_ranges initializer not found in source", 1)
    if count > 1:
        die(
            f"error: frequency_ranges initializer found {count} times,"
            f" expected exactly 1",
            1,
        )

    start = matches[0].end()

    # Find the matching }; by tracking brace depth (depth 1 = inside outer {).
    depth = 1
    i = start
    n = len(stripped)
    while i < n and depth > 0:
        c = stripped[i]
        if c == '{':
            depth += 1
        elif c == '}':
            depth -= 1
        i += 1

    if depth != 0:
        die("error: unmatched brace in frequency_ranges initializer", 1)

    # i is one past the closing }.  Check the ; follows.
    close_pos = i - 1
    after = stripped[i:].lstrip()
    if not after.startswith(';'):
        die("error: expected ';' after frequency_ranges closing '}'", 1)

    body = stripped[start:close_pos]
    return _parse_body(body)


def validate(rows):
    """Validate extracted rows. Dies (exit 1) on the first failing rule.

    Per-row checks run before the total-count and per-region-count checks so
    that each rule has its own clear error message.
    """
    for idx, row in enumerate(rows):
        op_class, min_chan, max_chan, base_freq, spacing, region = row
        if not 0 <= op_class <= 255:
            die(f"error: row {idx}: op_class {op_class} out of range 0..=255", 1)
        if not 0 <= min_chan <= 255:
            die(f"error: row {idx}: min_chan {min_chan} out of range 0..=255", 1)
        if not 0 <= max_chan <= 255:
            die(f"error: row {idx}: max_chan {max_chan} out of range 0..=255", 1)
        if not 0 <= base_freq <= 65535:
            die(f"error: row {idx}: base_freq {base_freq} out of range 0..=65535", 1)
        if not 0 <= spacing <= 65535:
            die(f"error: row {idx}: spacing {spacing} out of range 0..=65535", 1)
        if min_chan > max_chan:
            die(f"error: row {idx}: min_chan {min_chan} > max_chan {max_chan}", 1)
        if spacing == 0:
            die(f"error: row {idx}: spacing must be > 0", 1)
        if region != "" and not re.match(r'^[A-Z]{2}$', region):
            die(
                f"error: row {idx}: region {region!r} must be empty"
                f" or two uppercase ASCII letters",
                1,
            )

    if len(rows) != EXPECTED_TOTAL:
        die(
            f"error: expected {EXPECTED_TOTAL} rows, got {len(rows)}",
            1,
        )

    # Count rows per region.
    counts = {}
    for row in rows:
        region = row[5]
        counts[region] = counts.get(region, 0) + 1

    for region, expected in EXPECTED_COUNTS.items():
        actual = counts.get(region, 0)
        if actual != expected:
            label = "global" if region == "" else region
            die(
                f"error: expected {expected} {label} rows, got {actual}",
                1,
            )


def build_fixture(rows):
    """Build the complete fixture text from validated rows."""
    lines = []
    for op_class, min_chan, max_chan, base_freq, spacing, region in rows:
        region_col = region if region else "-"
        lines.append(
            f"{op_class}\t{min_chan}\t{max_chan}\t{base_freq}\t{spacing}\t{region_col}\n"
        )
    return FIXTURE_HEADER + "".join(lines)


def main():
    script_dir = Path(__file__).resolve().parent
    repo_root = script_dir.parent
    default_upstream = repo_root.parent / "unified-wifi-mesh"
    default_out = repo_root / "crates/em-utils/tests/data/upstream_freq_ranges.tsv"

    parser = argparse.ArgumentParser(
        description="Generate or check the upstream frequency ranges golden fixture."
    )
    parser.add_argument(
        "--upstream",
        type=Path,
        default=default_upstream,
        metavar="PATH",
        help=f"Path to upstream unified-wifi-mesh checkout (default: {default_upstream})",
    )
    parser.add_argument(
        "--out",
        type=Path,
        default=default_out,
        metavar="PATH",
        help=f"Output fixture path (default: {default_out})",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check mode: regenerate and compare, do not write",
    )
    args = parser.parse_args()

    # Step 1: Read source from git.
    source = read_source(args.upstream)

    # Step 2: Extract rows.
    rows = extract(source)

    # Step 3: Validate (dies before any write on failure).
    validate(rows)

    # Step 4: Build fixture text.
    fixture_text = build_fixture(rows)
    fixture_bytes = fixture_text.encode("utf-8")

    # Step 5: Write or check.
    if args.check:
        try:
            existing_bytes = args.out.read_bytes()
        except FileNotFoundError:
            die(f"error: fixture file not found: {args.out}", 1)
        except OSError as exc:
            die(f"error: cannot read fixture file: {exc}", 2)
        if existing_bytes != fixture_bytes:
            existing_lines = existing_bytes.decode("utf-8", errors="replace").splitlines(
                keepends=True
            )
            generated_lines = fixture_text.splitlines(keepends=True)
            diff = difflib.unified_diff(
                existing_lines,
                generated_lines,
                fromfile=str(args.out),
                tofile="<generated>",
            )
            sys.stdout.writelines(diff)
            sys.exit(1)
    else:
        try:
            args.out.parent.mkdir(parents=True, exist_ok=True)
            args.out.write_bytes(fixture_bytes)
        except OSError as exc:
            die(f"error: cannot write fixture file: {exc}", 2)

    # Step 6: Print success summary.
    counts = {}
    for row in rows:
        region = row[5]
        counts[region] = counts.get(region, 0) + 1

    total = len(rows)
    global_n = counts.get("", 0)
    us_n = counts.get("US", 0)
    eu_n = counts.get("EU", 0)
    jp_n = counts.get("JP", 0)
    cn_n = counts.get("CN", 0)
    print(
        f"ok: {total} rows"
        f" ({global_n} global, {us_n} US, {eu_n} EU, {jp_n} JP, {cn_n} CN)"
    )


if __name__ == "__main__":
    main()
