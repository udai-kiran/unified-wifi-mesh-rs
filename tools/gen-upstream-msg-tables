#!/usr/bin/env python3
"""Generate or check the golden fixture for upstream message validation tables.

Reads src/em/em_msg.cpp and inc/em_base.h from the pinned upstream commit
via git, extracts the em_msg_t table functions (one per validated message
type) and the constructor's switch that maps message types to them, and
writes (or checks) the fixture at
crates/em-msg/tests/data/upstream_msg_tables.tsv.

Message type and TLV type names are checked against the em-types fixture
crates/em-types/tests/data/upstream_enums.tsv.

Contract and known limits: the tool reads only the pinned upstream files and
is not a C preprocessor. It fails loudly (exit 1) on the constructs it does
not support, such as raw or prefixed literals, digit separators and
digraphs. Known limits, not handled:
- R2-02: vertical tab or form feed inside preprocessor directives.
- R2-03: code before or after the include guard is not checked.
- R2-05: conservative rejections such as SIGN_''x'' style tokens or "<::".
- R2-07: table/switch brace masking is covered only by helper tests.
On any change to PINNED_COMMIT, re-extract the fixture independently and
compare before trusting --check.
"""
# SPDX-License-Identifier: Apache-2.0

import argparse
import difflib
import re
import subprocess
import sys
from pathlib import Path

