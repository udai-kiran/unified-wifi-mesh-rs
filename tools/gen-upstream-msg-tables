    "len=static_cast<unsignedint>(len-(sizeof(em_raw_hdr_t)+sizeof(em_cmdu_t)));"
    "if(em_configuration_t::get_wsc_msg_type(tlvs,len)==em_wsc_msg_type_m1){autoconfig_wsc_m1();}"
