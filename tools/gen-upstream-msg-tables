#!/usr/bin/env python3
"""Generate or check the golden fixture for upstream message validation tables.

Reads src/em/em_msg.cpp and inc/em_base.h from the pinned upstream commit
via git, extracts the em_msg_t table functions (one per validated message
type) and the constructor's switch that maps message types to them, and
writes (or checks) the fixture at
crates/em-msg/tests/data/upstream_msg_tables.tsv.

Message type and TLV type names are checked against the em-types fixture
crates/em-types/tests/data/upstream_enums.tsv.
"""
# SPDX-License-Identifier: Apache-2.0

import argparse
import difflib
import re
import subprocess
import sys
from pathlib import Path

PINNED_COMMIT = "ba4180ba36748629f10c20babc4320dd69c9db4f"
SOURCE_PATH = "src/em/em_msg.cpp"
BASE_HEADER_PATH = "inc/em_base.h"

FIXTURE_HEADER = (
    "# Generated by tools/gen-upstream-msg-tables. Do not edit by hand.\n"
    "# Source: rdkcentral/unified-wifi-mesh src/em/em_msg.cpp"
    f" and inc/em_base.h @ {PINNED_COMMIT}\n"
    "# Regenerate: tools/gen-upstream-msg-tables\n"
    "# Check: tools/gen-upstream-msg-tables --check\n"
    "# SPDX-License-Identifier: Apache-2.0\n"
    "msg_type\twsc\ttable\trow\ttlv_type\trule\tmin_len\tspec\n"
)

EXPECTED_TABLES = 70
EXPECTED_MSG_TYPES = 69
EXPECTED_MAPPINGS = 70
EXPECTED_ROWS = 179
EXPECTED_EMPTY_TABLES = 6
MAX_MIN_LEN = 65535

# Values of the two non-literal minimum lengths.
EXT_DEV_INFO_SZ_NAME = "EMEX_MIN_EXT_DEV_INFO_SZ"
EXPECTED_EXT_DEV_INFO_SZ = 16
TLV_HEADER_PLUS_2 = 5

WSC_MSG_TYPE = "em_msg_type_autoconf_wsc"

# The WSC case at the pinned commit, with all whitespace removed.
# Any change upstream must be reviewed by a person.
PINNED_WSC_CASE = (
    "tlvs=tlvs+sizeof(em_raw_hdr_t)+sizeof(em_cmdu_t);"
    "len=static_cast<unsignedint>(len-(sizeof(em_raw_hdr_t)+sizeof(em_cmdu_t)));"
    "if(em_configuration_t::get_wsc_msg_type(tlvs,len)==em_wsc_msg_type_m1){autoconfig_wsc_m1();}"
    "elseif(em_configuration_t::get_wsc_msg_type(tlvs,len)==em_wsc_msg_type_m2){autoconfig_wsc_m2();}"
    "break;"
)

# Integer pattern: decimal only, no leading zeros (010 is octal in C).
_RE_INT = re.compile(r'0|[1-9][0-9]*')
_RE_WS = re.compile(r'\s*')
_RE_IDENT = re.compile(r'[A-Za-z_][A-Za-z0-9_]*')
_WORD = r'(?:mandatory|optional|bad)(?![A-Za-z0-9_])'
_RE_WORD = re.compile(_WORD)
_RE_TERNARY = re.compile(
    r'\(\s*m_profile\s*>\s*em_profile_type_([12])\s*\)\s*\?\s*'
    rf'({_WORD})\s*:\s*({_WORD})'
)
_RE_STMT_START = re.compile(
    r'm_tlv_member\s*\[\s*m_num_tlv\s*\+\+\s*\]\s*=\s*em_tlv_member_t\s*\('
)
_RE_SIZEOF_MIN = re.compile(
    r'static_cast\s*<\s*int\s*>\s*\(\s*sizeof\s*\(\s*em_tlv_t\s*\)\s*\+\s*2\s*\)'
)
_RE_EXT_NAME = re.compile(EXT_DEV_INFO_SZ_NAME + r'(?![A-Za-z0-9_])')
# A table function definition: void em_msg_t::<name>() {
_RE_TABLE_FUNC = re.compile(
    r'void\s+em_msg_t\s*::\s*([A-Za-z_][A-Za-z0-9_]*)\s*\(\s*\)\s*\{'
)
_RE_CTOR = re.compile(
    r'em_msg_t\s*::\s*em_msg_t\s*\(\s*em_msg_type_t\s+type\s*,'
    r'\s*em_profile_type_t\s+profile\s*,\s*unsigned\s+char\s*\*\s*tlvs\s*,'
    r'\s*unsigned\s+int\s+len\s*\)\s*\{'
)
_RE_SWITCH = re.compile(r'switch\s*\(\s*type\s*\)\s*\{')
_RE_LABEL = re.compile(
    r'(?<![A-Za-z0-9_])(?:case\s+([A-Za-z_][A-Za-z0-9_]*)\s*:(?!:)|default\s*:(?!:))'
)
# Whitespace-free ordinary case body: 'name();break;'.
_RE_ORDINARY_CASE = re.compile(r'([A-Za-z_][A-Za-z0-9_]*)\(\);break;')
_RE_DEFINE_LINE = re.compile(
    r'^[ \t]*#[ \t]*define[ \t]+' + EXT_DEV_INFO_SZ_NAME + r'(?![A-Za-z0-9_]).*$',
    re.MULTILINE,
)
_RE_DEFINE_STRICT = re.compile(
    r'#[ \t]*define[ \t]+' + EXT_DEV_INFO_SZ_NAME + r'[ \t]+(0|[1-9][0-9]*)[ \t]*'
)


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def read_source(upstream_path, path):
    """Read one file from the pinned commit via git."""
    try:
        result = subprocess.run(
            ["git", "--no-replace-objects", "-C", str(upstream_path), "show",
             f"{PINNED_COMMIT}:{path}"],
            capture_output=True,
        )
    except OSError as exc:
        die(f"error: could not run git: {exc}", 2)
    if result.returncode != 0:
        sys.stderr.buffer.write(result.stderr)
        sys.exit(2)
    try:
        return result.stdout.decode("utf-8", errors="strict")
    except UnicodeDecodeError as exc:
        die(f"error: git output is not valid UTF-8: {exc}", 2)


def load_type_names(path):
    """Read the em-types fixture; return (msg_type_names, tlv_type_names) as sets."""
    try:
        text = Path(path).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        die(f"error: cannot read em-types fixture {path}: {exc}", 2)
    msg_names = set()
    tlv_names = set()
    for number, line in enumerate(text.splitlines(), start=1):
        if line.startswith("#") or line.startswith("upstream_type\t"):
            continue
        fields = line.split("\t")
        if len(fields) != 3:
            die(f"error: {path}:{number}: expected 3 tab-separated fields", 1)
        if fields[0] == "em_msg_type_t":
            msg_names.add(fields[1])
        elif fields[0] == "em_tlv_type_t":
            tlv_names.add(fields[1])
    if not msg_names or not tlv_names:
        die(f"error: {path}: no em_msg_type_t or em_tlv_type_t names found", 1)
    return msg_names, tlv_names


def strip_comments(source):
    """Remove // and /* */ comments but not inside double-quoted strings.

    Uses a character-by-character state machine. Line comments keep their
    newline; a block comment becomes one space.
    Dies on unterminated strings or block comments (exit 1).
    """
    result = []
    i = 0
    n = len(source)
    while i < n:
        c = source[i]

        if c == '"':
            # String literal: copy verbatim including escape sequences.
            result.append(c)
            i += 1
            closed = False
            while i < n:
                c2 = source[i]
                result.append(c2)
                i += 1
                if c2 == '\\':
                    # Escape sequence: include next char too.
                    if i < n:
                        result.append(source[i])
                        i += 1
                elif c2 == '"':
                    closed = True
                    break
            if not closed:
                die("error: unterminated string literal in source", 1)

        elif source[i:i+2] == '//':
            # Line comment: skip to end of line, keep the newline itself.
            i += 2
            while i < n and source[i] != '\n':
                i += 1

        elif source[i:i+2] == '/*':
            # Block comment: skip to closing */.
            i += 2
            while i < n and source[i:i+2] != '*/':
                i += 1
            if i >= n:
                die("error: unterminated block comment in source", 1)
            i += 2  # skip */
            # A comment separates tokens, like whitespace: 9/**/1 is not 91.
            result.append(" ")

        else:
            result.append(c)
            i += 1

    return ''.join(result)


def read_ext_dev_info_sz(header_text):
    """Return the value of EMEX_MIN_EXT_DEV_INFO_SZ from em_base.h text.

    Dies (exit 1) unless there is exactly one strict decimal #define and
    its value is 16.
    """
    lines = _RE_DEFINE_LINE.findall(strip_comments(header_text))
    if len(lines) != 1:
        die(
            f"error: expected exactly 1 #define {EXT_DEV_INFO_SZ_NAME},"
            f" found {len(lines)}",
            1,
        )
    m = _RE_DEFINE_STRICT.fullmatch(lines[0].strip())
    if not m:
        die(f"error: unsupported #define {EXT_DEV_INFO_SZ_NAME}: {lines[0]!r}", 1)
    value = int(m.group(1))
    if value != EXPECTED_EXT_DEV_INFO_SZ:
        die(
            f"error: {EXT_DEV_INFO_SZ_NAME} is {value},"
            f" expected {EXPECTED_EXT_DEV_INFO_SZ}",
            1,
        )
    return value


def _skip_ws(text, pos):
    """Return position after skipping any whitespace at pos."""
    return _RE_WS.match(text, pos).end()


def _matching_brace(text, open_pos, what):
    """Return the index of the } that closes the { at open_pos.

    Braces inside double-quoted strings are ignored. Dies if unmatched.
    """
    depth = 0
    i = open_pos
    n = len(text)
    while i < n:
        c = text[i]
        if c == '"':
            i += 1
            while i < n and text[i] != '"':
                i += 2 if text[i] == '\\' else 1
        elif c == '{':
            depth += 1
        elif c == '}':
            depth -= 1
            if depth == 0:
                return i
        i += 1
    die(f"error: unmatched brace in {what}", 1)


def _parse_requirement(body, pos, where):
    """Parse a requirement. Returns (rule_text, new_pos)."""
    m = _RE_WORD.match(body, pos)
    if m:
        return m.group(), m.end()
    m = _RE_TERNARY.match(body, pos)
    if m:
        level, yes, no = m.groups()
        return f"profile>{level}?{yes}:{no}", m.end()
    die(f"error: {where}: unsupported requirement, got {body[pos:pos+40]!r}", 1)


def _parse_min_len(body, pos, ext_dev_info_sz, where):
    """Parse a minimum length. Returns (value, new_pos)."""
    m = _RE_INT.match(body, pos)
    if m:
        return int(m.group()), m.end()
    m = _RE_EXT_NAME.match(body, pos)
    if m:
        return ext_dev_info_sz, m.end()
    m = _RE_SIZEOF_MIN.match(body, pos)
    if m:
        return TLV_HEADER_PLUS_2, m.end()
    die(f"error: {where}: unsupported minimum length, got {body[pos:pos+40]!r}", 1)


def _expect(body, pos, char, what, where):
    """Skip whitespace, require char, return the position after it."""
    pos = _skip_ws(body, pos)
    if pos >= len(body) or body[pos] != char:
        die(f"error: {where}: expected {char!r} {what}, got {body[pos:pos+40]!r}", 1)
    return pos + 1


def _parse_row(body, pos, table, index, tlv_names, ext_dev_info_sz):
    """Parse one em_tlv_member_t statement starting at pos.

    Returns ((tlv, rule, min_len, spec), new_pos) with new_pos after the ';'.
    """
    where = f"table {table} row {index}"
    m = _RE_STMT_START.match(body, pos)
    if not m:
        die(f"error: table {table}: unexpected text {body[pos:pos+40]!r}", 1)
    pos = _skip_ws(body, m.end())

    m = _RE_IDENT.match(body, pos)
    if not m:
        die(f"error: {where}: expected TLV type name, got {body[pos:pos+40]!r}", 1)
    tlv = m.group()
    if tlv not in tlv_names:
        die(f"error: {where}: unknown TLV type {tlv!r}", 1)
    pos = _expect(body, m.end(), ',', "after TLV type", where)

    pos = _skip_ws(body, pos)
    rule, pos = _parse_requirement(body, pos, where)
    pos = _expect(body, pos, ',', "after requirement", where)

    pos = _skip_ws(body, pos)
    if pos >= len(body) or body[pos] != '"':
        die(f"error: {where}: expected spec string, got {body[pos:pos+40]!r}", 1)
    end = pos + 1
    while end < len(body) and body[end] not in '"\\\n':
        end += 1
    if end >= len(body) or body[end] != '"':
        die(f"error: {where}: spec string is unterminated or has an escape", 1)
    spec = body[pos + 1:end]
    if spec == "":
        die(f"error: {where}: spec string is empty", 1)
    if "\t" in spec:
        die(f"error: {where}: spec string contains a tab", 1)
    pos = _expect(body, end + 1, ',', "after spec string", where)

    pos = _skip_ws(body, pos)
    min_len, pos = _parse_min_len(body, pos, ext_dev_info_sz, where)
    pos = _expect(body, pos, ')', "after minimum length", where)
    pos = _expect(body, pos, ';', "after row", where)
    return (tlv, rule, min_len, spec), pos


def _parse_table_body(body, table, tlv_names, ext_dev_info_sz):
    """Parse a table function body; return its rows. Dies on any other text."""
    rows = []
    pos = 0
    while True:
        pos = _skip_ws(body, pos)
        if pos >= len(body):
            return rows
        row, pos = _parse_row(body, pos, table, len(rows), tlv_names, ext_dev_info_sz)
        rows.append(row)


def _extract_tables(stripped, tlv_names, ext_dev_info_sz):
    """Return [(name, rows)] for every void em_msg_t::name() definition."""
    tables = []
    seen = set()
    for m in _RE_TABLE_FUNC.finditer(stripped):
        name = m.group(1)
        if name in seen:
            die(f"error: table function {name} defined twice", 1)
        seen.add(name)
        open_pos = m.end() - 1
        close_pos = _matching_brace(stripped, open_pos, f"table function {name}")
        body = stripped[open_pos + 1:close_pos]
        tables.append((name, _parse_table_body(body, name, tlv_names, ext_dev_info_sz)))
    return tables


def _switch_body(stripped):
    """Return the text between the braces of the constructor's switch (type)."""
    ctors = list(_RE_CTOR.finditer(stripped))
    if len(ctors) != 1:
        die(f"error: expected exactly 1 em_msg_t constructor, found {len(ctors)}", 1)
    open_pos = ctors[0].end() - 1
    close_pos = _matching_brace(stripped, open_pos, "em_msg_t constructor")
    ctor_body = stripped[open_pos + 1:close_pos]

    switches = list(_RE_SWITCH.finditer(ctor_body))
    if len(switches) != 1:
        die(f"error: expected exactly 1 switch (type), found {len(switches)}", 1)
    sw_open = switches[0].end() - 1
    sw_close = _matching_brace(ctor_body, sw_open, "switch (type)")
    return ctor_body[sw_open + 1:sw_close]


def _case_segments(sw_body):
    """Return [(message type, text after the label)] for each case; default is skipped."""
    labels = list(_RE_LABEL.finditer(sw_body))
    segments = []
    for idx, label in enumerate(labels):
        if label.group(1) is None:  # default:
            continue
        seg_end = labels[idx + 1].start() if idx + 1 < len(labels) else len(sw_body)
        segments.append((label.group(1), sw_body[label.end():seg_end]))
    return segments


def _ordinary_mapping(msg_type, compact, table_names):
    """Return [(msg_type, '-', table)] for a case that is exactly 'name(); break;'."""
    m = _RE_ORDINARY_CASE.fullmatch(compact)
    if not m:
        die(
            f"error: case {msg_type}: expected exactly 'table(); break;',"
            f" got {compact[:80]!r}",
            1,
        )
    name = m.group(1)
    if name not in table_names:
        die(f"error: case {msg_type}: call to unknown function {name}()", 1)
    return [(msg_type, "-", name)]


def _wsc_mappings(msg_type, compact, table_names):
    """Return the two mappings of the WSC case.

    The whitespace-free case body must equal PINNED_WSC_CASE exactly, so any
    upstream change stops the generator for review. Both table functions it
    calls must be defined.
    """
    if compact != PINNED_WSC_CASE:
        position = next(
            (i for i, (a, b) in enumerate(zip(compact, PINNED_WSC_CASE)) if a != b),
            min(len(compact), len(PINNED_WSC_CASE)),
        )
        die(
            f"error: case {msg_type}: the WSC case differs from the pinned form"
            f" and must be reviewed; first difference at position {position}:"
            f" {compact[position:position + 40]!r}",
            1,
        )
    for name in ("autoconfig_wsc_m1", "autoconfig_wsc_m2"):
        if name not in table_names:
            die(f"error: case {msg_type}: table function {name} is not defined", 1)
    return [
        (msg_type, "m1", "autoconfig_wsc_m1"),
        (msg_type, "m2", "autoconfig_wsc_m2"),
    ]


def _extract_mappings(stripped, table_names, msg_names):
    """Return [(msg_type, wsc, table)] from the constructor's switch."""
    mappings = []
    seen_types = set()
    for msg_type, segment in _case_segments(_switch_body(stripped)):
        if msg_type in seen_types:
            die(f"error: case {msg_type} appears twice", 1)
        seen_types.add(msg_type)
        if msg_type not in msg_names:
            die(f"error: case {msg_type}: unknown message type", 1)
        compact = re.sub(r"\s+", "", segment)
        if msg_type == WSC_MSG_TYPE:
            mappings += _wsc_mappings(msg_type, compact, table_names)
        else:
            mappings += _ordinary_mapping(msg_type, compact, table_names)
    return mappings


def extract(source, msg_names, tlv_names, ext_dev_info_sz):
    """Extract (tables, mappings) from em_msg.cpp text. Dies on errors (exit 1).

    tables: [(name, [(tlv, rule, min_len, spec), ...])] in source order.
    mappings: [(msg_type, wsc, table)] in switch-case order.
    Every table function must be mapped exactly once. Counts are checked
    separately by validate().
    """
    stripped = strip_comments(source)
    tables = _extract_tables(stripped, tlv_names, ext_dev_info_sz)
    names = {name for name, _ in tables}
    mappings = _extract_mappings(stripped, names, msg_names)

    mapped = {}
    for _, _, table in mappings:
        mapped[table] = mapped.get(table, 0) + 1
    for name, _ in tables:
        count = mapped.get(name, 0)
        if count != 1:
            die(f"error: table {name} is mapped {count} times, expected 1", 1)
    return tables, mappings


def validate(tables, mappings):
    """Validate extracted data. Dies (exit 1) on the first failing rule."""
    for name, rows in tables:
        for idx, (_, _, min_len, _) in enumerate(rows):
            if not 0 <= min_len <= MAX_MIN_LEN:
                die(
                    f"error: table {name} row {idx}: min_len {min_len}"
                    f" out of range 0..={MAX_MIN_LEN}",
                    1,
                )

    if len(tables) != EXPECTED_TABLES:
        die(f"error: expected {EXPECTED_TABLES} tables, got {len(tables)}", 1)
    msg_types = len({msg_type for msg_type, _, _ in mappings})
    if msg_types != EXPECTED_MSG_TYPES:
        die(f"error: expected {EXPECTED_MSG_TYPES} message types, got {msg_types}", 1)
    if len(mappings) != EXPECTED_MAPPINGS:
        die(f"error: expected {EXPECTED_MAPPINGS} mappings, got {len(mappings)}", 1)
    row_count = sum(len(rows) for _, rows in tables)
    if row_count != EXPECTED_ROWS:
        die(f"error: expected {EXPECTED_ROWS} rows, got {row_count}", 1)
    empty = sum(1 for _, rows in tables if not rows)
    if empty != EXPECTED_EMPTY_TABLES:
        die(f"error: expected {EXPECTED_EMPTY_TABLES} empty tables, got {empty}", 1)


def build_fixture(tables, mappings):
    """Build the complete fixture text: one line per row, '-' line per empty table."""
    rows_by_table = dict(tables)
    lines = []
    for msg_type, wsc, table in mappings:
        rows = rows_by_table[table]
        if not rows:
            lines.append(f"{msg_type}\t{wsc}\t{table}\t-\t-\t-\t-\t-\n")
        for idx, (tlv, rule, min_len, spec) in enumerate(rows):
            lines.append(
                f"{msg_type}\t{wsc}\t{table}\t{idx}\t{tlv}\t{rule}\t{min_len}\t{spec}\n"
            )
    return FIXTURE_HEADER + "".join(lines)


def main():
    script_dir = Path(__file__).resolve().parent
    repo_root = script_dir.parent
    default_upstream = repo_root.parent / "unified-wifi-mesh"
    default_types = repo_root / "crates/em-types/tests/data/upstream_enums.tsv"
    default_out = repo_root / "crates/em-msg/tests/data/upstream_msg_tables.tsv"

    parser = argparse.ArgumentParser(
        description="Generate or check the upstream message tables golden fixture."
    )
    parser.add_argument(
        "--upstream",
        type=Path,
        default=default_upstream,
        metavar="PATH",
        help=f"Path to upstream unified-wifi-mesh checkout (default: {default_upstream})",
    )
    parser.add_argument(
        "--types",
        type=Path,
        default=default_types,
        metavar="PATH",
        help=f"em-types enum fixture (default: {default_types})",
    )
    parser.add_argument(
        "--out",
        type=Path,
        default=default_out,
        metavar="PATH",
        help=f"Output fixture path (default: {default_out})",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Check mode: regenerate and compare, do not write",
    )
    args = parser.parse_args()

    # Step 1: Read inputs.
    source = read_source(args.upstream, SOURCE_PATH)
    header_text = read_source(args.upstream, BASE_HEADER_PATH)
    msg_names, tlv_names = load_type_names(args.types)

    # Step 2: Extract tables and mappings.
    ext_dev_info_sz = read_ext_dev_info_sz(header_text)
    tables, mappings = extract(source, msg_names, tlv_names, ext_dev_info_sz)

    # Step 3: Validate (dies before any write on failure).
    validate(tables, mappings)

    # Step 4: Build fixture text.
    fixture_text = build_fixture(tables, mappings)
    fixture_bytes = fixture_text.encode("utf-8")

    # Step 5: Write or check.
    if args.check:
        try:
            existing_bytes = args.out.read_bytes()
        except FileNotFoundError:
            die(f"error: fixture file not found: {args.out}", 1)
        except OSError as exc:
            die(f"error: cannot read fixture file: {exc}", 2)
        if existing_bytes != fixture_bytes:
            existing_lines = existing_bytes.decode("utf-8", errors="replace").splitlines(
                keepends=True
            )
            generated_lines = fixture_text.splitlines(keepends=True)
            diff = difflib.unified_diff(
                existing_lines,
                generated_lines,
                fromfile=str(args.out),
                tofile="<generated>",
            )
            sys.stdout.writelines(diff)
            sys.exit(1)
    else:
        try:
            args.out.parent.mkdir(parents=True, exist_ok=True)
            args.out.write_bytes(fixture_bytes)
        except OSError as exc:
            die(f"error: cannot write fixture file: {exc}", 2)

    # Step 6: Print success summary.
    row_count = sum(len(rows) for _, rows in tables)
    empty = sum(1 for _, rows in tables if not rows)
    msg_types = len({msg_type for msg_type, _, _ in mappings})
    print(
        f"ok: {len(tables)} tables, {msg_types} message types,"
        f" {len(mappings)} mappings, {row_count} rows, {empty} empty"
    )


if __name__ == "__main__":
    main()
