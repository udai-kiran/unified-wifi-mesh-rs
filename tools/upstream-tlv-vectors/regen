        ("operational_bss", "01" + RUID_1 + "00"),
        ("channel_scan_req", "80" + "01" + RUID_10 + "00"),
        ("radio_id", RUID_1),
    ]),
    ("mixed-radio-reversed", [
        ("radio_id", RUID_1),
        ("channel_scan_req", "80" + "01" + RUID_10 + "00"),
        ("operational_bss", "01" + RUID_1 + "00"),
        ("he_cap", RUID_6 + "04" + "ffffffff" + "0000"),
        ("vht_cap", RUID_5 + "0000" + "0000" + "00" + "00"),
        ("ht_cap", RUID_4 + "00"),
        ("ap_radio_advanced_cap", RUID_3 + "00"),
        ("ap_radio_basic_cap", RUID_2 + "10" + "00"),
        ("bh_sta_radio_cap", RUID_13 + "00"),
        ("radio_metric", RUID_12 + "10203040"),
        ("channel_scan_rslt", RUID_11 + "7324" + "00" + "00" + "2010" + "0000" + "00000000" + "00"),
        ("op_channel_report", RUID_9 + "00" + "00"),
        ("channel_sel_resp", RUID_8 + "00"),
