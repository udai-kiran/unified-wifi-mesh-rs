def query_channels_text(channels):
    if not channels:
        return "none"
    parts = []
    for number, stations in channels:
        parts.append(f"{number}:{'+'.join(stations) if stations else '-'}")
    return ",".join(parts)


def response_entries_text(entries):
    if not entries:
        return "none"
    return ",".join("/".join(str(field) for field in entry) for entry in entries)


