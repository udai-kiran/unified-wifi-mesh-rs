# Cases of parse_profile_tlv, which takes a value and its length, not an area:
# (case, value hex, value_len).
PARSE_PROFILE_CASES = [
    ("value-0-length-1", "00", 1),
    ("value-1-length-1", "01", 1),
    ("value-2-length-1", "02", 1),
    ("value-3-length-1", "03", 1),
    ("value-4-length-1", "04", 1),
    ("value-ff-length-1", "ff", 1),
    ("value-1-length-4", "01000000", 4),
    ("value-2-length-4", "02000000", 4),
    ("value-3-length-4", "03000000", 4),
    ("value-4-length-4", "04000000", 4),
    ("value-2-length-0", "02", 0),
    ("value-2-length-2", "0200", 2),
    ("value-2-length-3", "020000", 3),
    ("value-2-length-5", "0200000000", 5),
]

GET_AL_MAC = "em_msg_t::get_al_mac_address"
GET_SERVICE = "em_msg_t::get_supported_service"
PARSE_PROFILE = "em_msg_t::parse_profile_tlv"
GET_PROFILE = "em_msg_t::get_profile"
GET_STA_MAC = "em_msg_t::get_sta_mac"
GET_BSS_ID = "em_msg_t::get_bss_id"
GET_RADIO_ID = "em_msg_t::get_radio_id"
GET_FREQ_BAND = "em_msg_t::get_freq_band"
GET_PROFILE_TYPE = "em_msg_t::get_profile_type"
GET_TLV = "em_msg_t::get_tlv(type)"
GET_TLV_IN_BUFFER = "em_msg_t::get_tlv(buff,len,type)"
GET_FIRST_TLV = "em_msg_t::get_first_tlv"
GET_NEXT_TLV = "em_msg_t::get_next_tlv"

# Readers run once per area, in this order (every area, every reader); then the readers that
# take a TLV type or an offset, then parse_profile_tlv. vectors.cpp writes rows in this order.
WHOLE_AREA_READERS = [GET_AL_MAC, GET_SERVICE, GET_PROFILE, GET_STA_MAC, GET_BSS_ID,
                      GET_RADIO_ID, GET_FREQ_BAND, GET_PROFILE_TYPE, GET_FIRST_TLV]
TYPE_READERS = [GET_TLV, GET_TLV_IN_BUFFER]
OUT_PARAMETER_READERS = {GET_AL_MAC, GET_SERVICE, GET_PROFILE, GET_STA_MAC, GET_BSS_ID,
                         GET_RADIO_ID, GET_FREQ_BAND, GET_PROFILE_TYPE}


def type_number(kind):
    return TLV_TYPES[kind] if isinstance(kind, str) else kind


def build_area(tlvs):
    """Concatenate the TLVs (type, 2-octet big-endian length, value) and the End of Message."""
    out = bytearray()
    for kind, value_hex in tlvs:
        value = bytes.fromhex(value_hex)
        out.append(type_number(kind))
        out.extend(len(value).to_bytes(2, "big"))
        out.extend(value)
    out.extend(b"\x00\x00\x00")
    return bytes(out)


def parse_area(data):
    """Split a well-formed area into (offset, type, value), the End of Message TLV last."""
    tlvs = []
    offset = 0
    while True:
        if offset + 3 > len(data):
            raise ContentError("area is not terminated by an End of Message TLV")
        length = int.from_bytes(data[offset + 1:offset + 3], "big")
        if offset + 3 + length > len(data):
            raise ContentError("area has a TLV that runs past its end")
        tlvs.append((offset, data[offset], data[offset + 3:offset + 3 + length]))
        if data[offset] == 0:
            if length != 0 or offset + 3 != len(data):
                raise ContentError("End of Message TLV is not the last, empty TLV")
            return tlvs
        offset += 3 + length


def probe_types(tlvs):
    """The TLV types get_tlv is asked for: each type in the area once, End of Message, an absent one."""
    types = []
    for _, kind, _ in tlvs:
        if kind != 0 and kind not in types:
            types.append(kind)
    return [*types, 0, ABSENT_TYPE]


def expected_reader_cases():
    """The exact (function, case) -> (inputs, area hex) rows of the reader fixture, in order."""
    rows = {}
    areas = [(name, build_area(tlvs)) for name, tlvs in READER_AREAS]
    for function in WHOLE_AREA_READERS:
        for name, area in areas:
            inputs = {"len": str(len(area))}
            if function in OUT_PARAMETER_READERS:
                inputs["fill"] = "ff"
            rows[(function, name)] = (inputs, area.hex())
    for function in TYPE_READERS:
        for name, area in areas:
            for kind in probe_types(parse_area(area)):
                rows[(function, f"{name}@type-{kind:02x}")] = (
                    {"len": str(len(area)), "type": f"{kind:02x}"}, area.hex())
    for name, area in areas:
        for offset, _, _ in parse_area(area):
            rows[(GET_NEXT_TLV, f"{name}@from-{offset}")] = (
                {"len": str(len(area)), "from": str(offset)}, area.hex())
    for case, value_hex, value_len in PARSE_PROFILE_CASES:
        rows[(PARSE_PROFILE, case)] = (
            {"value_len": str(value_len), "fill": "ff"}, value_hex)
    return rows


def _first(tlvs, kinds):
    """The first TLV (offset, type, value) whose type number is in kinds, in frame order."""
    for tlv in tlvs:
        if tlv[1] == 0:
            return None
        if tlv[1] in kinds:
            return tlv
    return None


def _need(value, size, what):
    if len(value) < size:
        raise ContentError(f"corpus TLV too short for {what}: {len(value)} < {size}")


def _bool_text(flag):
    return "true" if flag else "false"


def _profile_result(value, value_len):
    """Outcome of parse_profile_tlv for a value: (parsed, 4-octet little-endian profile)."""
    if value_len not in (1, 4) or value[0] >= 4:
        return False, None
    return True, bytes([value[0], 0, 0, 0])


def model_reader(function, inputs, area):
    """What a reader returns and writes, from the written-down behaviour, not from the C++.

    Returns (return text, output hex). The areas are well-formed, so a reader never meets a TLV
    that is too short for the field it reads; the model raises if the corpus has one.
    """
    if function == PARSE_PROFILE:
        parsed, profile = _profile_result(area, int(inputs["value_len"]))
        return _bool_text(parsed), (profile.hex() if parsed else "ffffffff")
    tlvs = parse_area(area)
    ty = TLV_TYPES
    unwritten_mac = "ff" * 6
    if function == GET_AL_MAC:
        found = _first(tlvs, {ty["al_mac_address"]})
        if found is None:
            return "false", unwritten_mac
        _need(found[2], 6, function)
        return "true", found[2][:6].hex()
    if function == GET_SERVICE:
        found = _first(tlvs, {ty["supported_service"]})
        if found is None:
            return "false", "ff" * 9
        value = found[2]
        _need(value, 1, function)
        count = value[0]
        if len(value) != 1 + count:
            raise ContentError("corpus Supported Service length does not match its count")
        if count > 8:
            # The count is written before the check that rejects it; the list stays untouched.
            return "false", f"{count:02x}" + "ff" * 8
        return "true", f"{count:02x}" + (value[1:] + bytes(8 - count)).hex()
    if function in (GET_PROFILE, GET_PROFILE_TYPE):
        found = _first(tlvs, {ty["profile"]})
        if found is None:
            return "false", "00000000"
        parsed, profile = _profile_result(found[2], len(found[2]))
        return _bool_text(parsed), (profile.hex() if parsed else "00000000")
    if function == GET_STA_MAC:
        found = _first(tlvs, {ty["client_info"], ty["client_assoc_event"], ty["bcon_metric_query"],
                              ty["bcon_metric_rsp"], ty["assoc_sta_link_metric"]})
        if found is None:
            return "false", unwritten_mac
        # The client MAC follows the BSSID in Client Info; it comes first in the other TLVs.
        start = 6 if found[1] == ty["client_info"] else 0
        _need(found[2], start + 6, function)
        return "true", found[2][start:start + 6].hex()
    if function == GET_BSS_ID:
        found = _first(tlvs, {ty["client_info"], ty["client_assoc_event"], ty["ap_metrics"],
                              ty["bssid"]})
        if found is None:
            return "false", unwritten_mac
        # The BSSID follows the client MAC in Client Association Event; it comes first elsewhere.
        start = 6 if found[1] == ty["client_assoc_event"] else 0
        _need(found[2], start + 6, function)
        return "true", found[2][start:start + 6].hex()
    if function == GET_RADIO_ID:
        return _model_radio_id(tlvs)
    if function == GET_FREQ_BAND:
        found = _first(tlvs, {ty["supported_freq_band"], ty["autoconf_freq_band"]})
        if found is None:
            return "false", "ff" * 4
        _need(found[2], 1, function)
        return "true", found[2][:1].hex() + "ff" * 3
    if function in (GET_TLV, GET_TLV_IN_BUFFER):
        wanted = int(inputs["type"], 16)
        if wanted == 0:
            return "-", "-"
        found = _first(tlvs, {wanted})
        return ("-" if found is None else str(found[0])), "-"
    if function == GET_FIRST_TLV:
        first = tlvs[0]
        # An empty first TLV (and the End of Message TLV) is rejected as having no value.
        return ("0" if len(first[2]) > 0 else "-"), "-"
    if function == GET_NEXT_TLV:
        offsets = [tlv[0] for tlv in tlvs]
        position = offsets.index(int(inputs["from"]))
        if position + 1 >= len(tlvs):
            return "-", "-"
        following = tlvs[position + 1]
        return ("-" if len(following[2]) == 0 else str(following[0])), "-"
    raise ContentError(f"unexpected reader {function}")


def _model_radio_id(tlvs):
    ty = TLV_TYPES
    at_start = {ty["radio_id"], ty["ap_radio_basic_cap"], ty["ap_radio_advanced_cap"],
                ty["ht_cap"], ty["vht_cap"], ty["he_cap"], ty["channel_pref"],
                ty["channel_sel_resp"], ty["op_channel_report"], ty["channel_scan_rslt"],
                ty["radio_metric"], ty["bh_sta_radio_cap"]}
    for _, kind, value in tlvs:
        if kind == ty["channel_scan_req"] and len(value) < 9:
            # sizeof(em_channel_scan_req_t) is 9; a shorter request ends the search.
            return "false", "ff" * 6
        if kind == 0:
            break
        if kind in at_start:
            _need(value, 6, GET_RADIO_ID)
            return "true", value[:6].hex()
        if kind == ty["operational_bss"]:
            _need(value, 1, GET_RADIO_ID)
            if value[0] >= 1:
                _need(value, 7, GET_RADIO_ID)
                return "true", value[1:7].hex()
            continue  # no radios: keep walking
        if kind == ty["channel_scan_req"]:
            if value[1] != 0:
                return "true", value[2:8].hex()
            return "false", "ff" * 6  # no radios: the search ends here
    return "false", "ff" * 6


def validate_reader_body(body):
    """Reject an incomplete or inconsistent reader harness result. Returns the data rows."""
    try:
        lines = body.decode("ascii").splitlines()
    except UnicodeDecodeError as exc:
        raise ContentError("reader harness output is not ASCII") from exc
    if not body.endswith(b"\n"):
        raise ContentError("reader harness output does not end with a newline")
    data = [line for line in lines if not line.startswith("#")]
    if not data or data[0] != READER_COLUMN_LINE:
        raise ContentError("missing reader column line")
    rows = [line.split("\t") for line in data[1:]]
    expected = expected_reader_cases()
    keys = []
    for row in rows:
        if len(row) != 6 or any(not column for column in row):
            raise ContentError(f"invalid reader TSV row {row}")
        case, function, inputs, area_hex, returned, output = row
        key = (function, case)
        keys.append(key)
        try:
            if key not in expected:
                raise ContentError(f"{function}/{case}: unexpected case")
            actual_inputs = _fields(inputs)
            expected_inputs, expected_area = expected[key]
            if actual_inputs != expected_inputs:
                raise ContentError(f"{function}/{case}: inputs differ from expected: "
                                   f"expected {expected_inputs}, got {actual_inputs}")
            if area_hex != expected_area:
                raise ContentError(f"{function}/{case}: area differs from the corpus")
            check_reader_row(case, function, actual_inputs, area_hex, returned, output)
        except (KeyError, ValueError) as exc:
            raise ContentError(f"{function}/{case}: {exc}") from exc
    if len(set(keys)) != len(keys):
        raise ContentError("duplicate reader (function, case) row")
    if keys != list(expected):
        missing = [key for key in expected if key not in keys]
        raise ContentError(f"reader case list differs from expected; missing {missing[:5]}")
    return rows


def check_reader_row(case, function, inputs, area_hex, returned, output):
    if not HEX_OR_DASH.fullmatch(area_hex) or not HEX_OR_DASH.fullmatch(output):
        raise ContentError(f"{function}/{case}: bad area or output hex")
    area = bytes.fromhex(area_hex)
    if function != PARSE_PROFILE and inputs["len"] != str(len(area)):
        raise ContentError(f"{function}/{case}: len differs from the area length")
    expected_return, expected_output = model_reader(function, inputs, area)
    if (returned, output) != (expected_return, expected_output):
        raise ContentError(f"{function}/{case}: expected return {expected_return} and output "
                           f"{expected_output}, got {returned} and {output}")


def provenance_header(cxx_version, cxx, cxxflags, fields, with_senders):
    header = ["# Generated by tools/upstream-tlv-vectors/regen; do not edit.\n",
              f"# Upstream: rdkcentral/unified-wifi-mesh @ {PIN}\n",
              "# Extraction command: git --no-replace-objects -C <upstream> show <pin>:<path>\n"]
    for path, first, last, _, name in DEFINES:
        header.append(f"# Extract macro {name}: git show {PIN}:{path} lines {first}-{last}\n")
    for path, first, last, _, name in STRUCTS:
        header.append(f"# Extract struct {name}: git show {PIN}:{path} lines {first}-{last}\n")
    for path, first, last, _, name, _ in PLAIN_TYPES:
        header.append(f"# Extract type {name}: git show {PIN}:{path} lines {first}-{last}\n")
    if with_senders:
        for path, first, last, _, qualifier in SENDERS:
            header.append(f"# Extract function ({qualifier}:: removed): "
                          f"git show {PIN}:{path} lines {first}-{last}\n")
    else:
        for path, first, last, _, qualifier in READERS:
            header.append(f"# Extract member function ({qualifier}:: kept): "
                          f"git show {PIN}:{path} lines {first}-{last}\n")
    header.extend([f"# C++ compiler: {cxx_version}\n",
                   f"# Compile: {cxx} {' '.join(cxxflags)} vectors.cpp -o vectors\n",
                   "# Run: ./vectors <sender output> <reader output>\n",
                   "# Regenerate: python3 tools/upstream-tlv-vectors/regen\n",
                   "# Check: python3 tools/upstream-tlv-vectors/regen --check\n",
                   fields])
    return header


def build_fixture(body, cxx, cxx_version, cxxflags):
    header = provenance_header(
        cxx_version, cxx, cxxflags,
        "# Fields: case, function, inputs, return (bytes written), hex (lowercase; '-' is empty).\n",
        with_senders=True)
    header.append("# Probe lines give the GCC layout of each extracted struct.\n")
    return "".join(header).encode("utf-8") + body


def build_reader_fixture(body, cxx, cxx_version, cxxflags):
    header = provenance_header(
        cxx_version, cxx, cxxflags,
        "# Fields: case, function, inputs, area (hex of the TLV area; for parse_profile_tlv the "
        "value), return (true, false, an offset into the area, or '-' for NULL), output (hex of "
        "what the reader wrote; 'ff' bytes were not written; '-' for none).\n",
        with_senders=False)
    header.append("# Inputs: len is the area length (m_len or buff_len); fill=ff means the output "
                  "object was pre-filled with 0xff.\n")
    return "".join(header).encode("utf-8") + body


def write_atomically(path, data):
    write_all_atomically([(path, data)])


def write_all_atomically(files):
    """Write every (path, data), each by rename. Nothing is renamed unless every temporary file
    was written."""
    staged = []
    try:
        for path, data in files:
            path.parent.mkdir(parents=True, exist_ok=True)
            fd, name = tempfile.mkstemp(dir=path.parent, prefix=".tmp-")
            staged.append((name, path))
            with os.fdopen(fd, "wb") as file:
                file.write(data)
            os.chmod(name, 0o644)
        for name, path in staged:
            os.replace(name, path)
    except BaseException as original:
        for name, _ in staged:
            try:
                os.unlink(name)
            except FileNotFoundError:
                pass
            except OSError as cleanup:
                raise ToolError(f"atomic write failed: {original}; cannot remove temporary file "
                                f"{name}: {cleanup}") from original
        raise


def generate(upstream, cxx):
    """Build both fixtures in memory. Returns (sender bytes, reader bytes, sender rows, reader rows)."""
    sources = read_sources(upstream)
    with tempfile.TemporaryDirectory(prefix="upstream-tlv-") as tmp:
        scratch = Path(tmp)
        write_extractions(sources, scratch)
        body, reader_body, cxx_version, cxxflags = compile_and_run(scratch, cxx)
    check_probe(body)
    rows = validate_body(body)
    reader_rows = validate_reader_body(reader_body)
    return (build_fixture(body, cxx, cxx_version, cxxflags),
            build_reader_fixture(reader_body, cxx, cxx_version, cxxflags), rows, reader_rows)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--upstream", type=Path, default=ROOT.parent / "unified-wifi-mesh")
    parser.add_argument("--out", type=Path, default=FIXTURE, help="sender fixture")
    parser.add_argument("--reader-out", type=Path, default=READER_FIXTURE, help="reader fixture")
    parser.add_argument("--cxx", default="c++")
    parser.add_argument("--check", action="store_true",
                        help="rebuild in memory and compare both fixtures; write nothing")
    args = parser.parse_args(argv)
    try:
        data, reader_data, rows, reader_rows = generate(args.upstream, args.cxx)
        if args.check:
            stale = [str(path) for path, expected in ((args.out, data), (args.reader_out, reader_data))
                     if path.read_bytes() != expected]
            if stale:
                raise ContentError(f"fixture differs: {', '.join(stale)}")
        else:
            write_all_atomically([(args.out, data), (args.reader_out, reader_data)])
        print(f"ok: {len(rows)} sender rows, {len(reader_rows)} reader rows")
        return 0
    except (ContentError, KeyError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except (ToolError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
