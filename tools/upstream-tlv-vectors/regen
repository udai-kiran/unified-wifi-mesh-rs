def _fields(text):
    result = {}
    for pair in text.split(";"):
        key, separator, value = pair.partition("=")
        if not separator or not re.fullmatch(r"[a-z_]+", key) or key in result or not value:
            raise ContentError(f"invalid or duplicate input field in {text!r}")
        result[key] = value
    return result


def validate_body(body):
    """Reject an incomplete or inconsistent harness result. Returns the data rows."""
    try:
        lines = body.decode("ascii").splitlines()
    except UnicodeDecodeError as exc:
        raise ContentError("harness output is not ASCII") from exc
    if not body.endswith(b"\n"):
        raise ContentError("harness output does not end with a newline")
    data = [line for line in lines if not line.startswith("#")]
    if not data or data[0] != COLUMN_LINE:
        raise ContentError("missing column line")
    rows = [line.split("\t") for line in data[1:]]
    keys = []
    expected_inputs = expected_case_inputs()
    for row in rows:
        if len(row) != 5 or any(not column for column in row):
            raise ContentError(f"invalid TSV row {row}")
        case, function, inputs, returned, hex_text = row
        key = (function, case)
        keys.append(key)
        try:
            actual_inputs = _fields(inputs)
            if key not in expected_inputs:
                raise ContentError(f"{function}/{case}: unexpected case")
            if actual_inputs != expected_inputs[key]:
                raise ContentError(f"{function}/{case}: inputs differ from expected: "
                                   f"expected {expected_inputs[key]}, got {actual_inputs}")
            check_row(case, function, actual_inputs, returned, hex_text)
        except (KeyError, ValueError) as exc:
            raise ContentError(f"{function}/{case}: {exc}") from exc
    if len(set(keys)) != len(keys):
        raise ContentError("duplicate (function, case) row")
    expected = expected_cases()
    if keys != expected:
        missing = [key for key in expected if key not in keys]
        raise ContentError(f"case list differs from expected; missing {missing}, got {keys}")
    return rows


def _mac_bytes(text, where):
    if not re.fullmatch(r"(?:[0-9a-f]{2}){6}", text):
        raise ContentError(f"{where}: bad MAC {text!r}")
    return bytes.fromhex(text)


def expected_query_bytes(inputs):
    """The Unassociated STA Link Metrics Query value for the inputs, built from the spec layout:
    operating class, channel count, then per channel the number, the STA count and the MACs."""
    out = bytearray([int(inputs["op_class"])])
    if inputs["channels"] == "none":
        out.append(0)
        return bytes(out)
    channels = inputs["channels"].split(",")
    out.append(len(channels))
    for channel in channels:
        number, _, stations = channel.partition(":")
        macs = [] if stations == "-" else stations.split("+")
        out.extend([int(number), len(macs)])
        for mac in macs:
            out.extend(_mac_bytes(mac, "query"))
    return bytes(out)


def expected_response_bytes(inputs):
    """The Unassociated STA Link Metrics Response value: operating class, STA count, then per STA
    of that class the MAC, channel, 4-octet big-endian time delta and RCPI."""
    op_class = int(inputs["op_class"])
    body = bytearray()
    count = 0
    if inputs["entries"] != "none":
        for entry in inputs["entries"].split(","):
            mac, channel, entry_class, rcpi, time_delta = entry.split("/")
            if int(entry_class) != op_class:
                continue
            body.extend(_mac_bytes(mac, "response"))
            body.append(int(channel))
            body.extend(int(time_delta).to_bytes(4, "big"))
            body.append(int(rcpi))
            count += 1
    return bytes([op_class, count]) + bytes(body)


def check_row(case, function, inputs, returned, hex_text):
    if not re.fullmatch(r"[0-9]+", returned) or not HEX_OR_DASH.fullmatch(hex_text):
        raise ContentError(f"{function}/{case}: bad return or hex")
    data = b"" if hex_text == "-" else bytes.fromhex(hex_text)
    if int(returned) != len(data):
        raise ContentError(f"{function}/{case}: return {returned} does not match {len(data)} bytes")
    if function == "em_t::create_prof_2_tlv":
        if set(inputs) != {"fill"} or len(data) != PROBE_EXPECTED["em_profile_2_ap_cap_t"]["sizeof"]:
            raise ContentError(f"{function}/{case}: wrong inputs or length")
        # src/em/em.cpp:1772-1797 at ba4180b sets max_prior_rule, reserved1 and
        # max_vid_count to 0 and only dpp_onboarding to 1 in the bit fields.
        # GCC places dpp_onboarding at 0x10 in the third byte for this layout.
        if data != bytes((0x00, 0x00, 0x10, 0x00)):
            raise ContentError(f"{function}/{case}: unexpected Profile-2 bytes {hex_text}")
    elif function == "em_configuration_t::create_error_code_tlv":
        if set(inputs) != {"fill", "val", "sta_mac"} or len(data) != 7:
            raise ContentError(f"{function}/{case}: wrong inputs or length")
        # memcpy of an int copies its low byte on the little-endian build host.
        if data[0] != int(inputs["val"]) & 0xFF:
            raise ContentError(f"{function}/{case}: first octet is not the low byte of val")
        if inputs["sta_mac"] == "null":
            expected_mac = bytes(6)
        elif re.fullmatch(r"(?:[0-9a-f]{2}){6}", inputs["sta_mac"]):
            expected_mac = bytes.fromhex(inputs["sta_mac"])
        else:
            raise ContentError(f"{function}/{case}: bad sta_mac")
        if data[1:] != expected_mac:
            raise ContentError(f"{function}/{case}: MAC octets differ from sta_mac")
    elif function == ERROR_CODE_METRICS:
        if set(inputs) != {"fill", "sta", "sta_found", "is_associated"} or len(data) != 7:
            raise ContentError(f"{function}/{case}: wrong inputs or length")
        # src/em/metrics/em_metrics.cpp:2384-2411: reason 1 when associated, else 0; sta_found
        # is ignored; then the station MAC.
        expected = bytes([1 if inputs["is_associated"] == "1" else 0])
        if data != expected + _mac_bytes(inputs["sta"], function):
            raise ContentError(f"{function}/{case}: unexpected bytes {hex_text}")
    elif function == CLIENT_INFO:
        if set(inputs) != {"fill", "sta", "bssid"}:
            raise ContentError(f"{function}/{case}: wrong inputs")
        # Client Info is the BSSID, then the client MAC, although the parameters are the other
        # way round.
        expected = _mac_bytes(inputs["bssid"], function) + _mac_bytes(inputs["sta"], function)
        if data != expected:
            raise ContentError(f"{function}/{case}: unexpected bytes {hex_text}")
    elif function == BACKHAUL_POLICY:
        if set(inputs) != {"fill", "bssid", "p_one", "p_two"}:
            raise ContentError(f"{function}/{case}: wrong inputs")
        bssid = _mac_bytes(inputs["bssid"], function)
        if bssid == bytes(6):
            # An all-zero BSSID writes nothing, whatever the flags are.
            expected = b""
        else:
            # GCC puts the bit-fields from the low bit: reserved 0-5, profile 2 bit 6, profile 1
            # bit 7 (the em_bh_bss_config_t `# Probe:` line has the 7-octet size).
            flags = (0x80 if inputs["p_one"] == "1" else 0) | (0x40 if inputs["p_two"] == "1" else 0)
            expected = bssid + bytes([flags])
        if data != expected:
            raise ContentError(f"{function}/{case}: unexpected bytes {hex_text}")
    elif function == UNASSOC_QUERY:
        if inputs.get("op") == "null":
            if set(inputs) != {"fill", "op"} or data:
                raise ContentError(f"{function}/{case}: NULL op must write nothing")
        elif set(inputs) != {"fill", "op_class", "channels"} or data != expected_query_bytes(inputs):
            raise ContentError(f"{function}/{case}: unexpected bytes {hex_text}")
    elif function == UNASSOC_RESPONSE:
        if set(inputs) != {"fill", "op_class", "entries"} or data != expected_response_bytes(inputs):
            raise ContentError(f"{function}/{case}: unexpected bytes {hex_text}")
    else:
        raise ContentError(f"unexpected function {function}")


