class ContentError(Exception):
    pass


class ToolError(Exception):
    pass


def run(command, **kwargs):
    try:
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kwargs)
    except OSError as exc:
        raise ToolError(f"cannot run {command[0]}: {exc}") from exc
    if result.returncode:
        detail = (result.stderr + result.stdout).decode("utf-8", "replace").strip()
        raise ToolError(f"command failed ({result.returncode}): {' '.join(map(str, command))}\n{detail}")
    return result.stdout


def read_sources(upstream):
    entries = DEFINES + STRUCTS + PLAIN_TYPES + SENDERS + READERS
    paths = sorted({entry[0] for entry in entries} | {EM_MSG_H})
    return {path: run(["git", "--no-replace-objects", "-C", str(upstream), "show", f"{PIN}:{path}"])
            for path in paths}


def mask_noncode(text):
    """Mask comments and ordinary C/C++ literals while preserving positions."""
    pattern = re.compile(r'//[^\n]*|/\*[\s\S]*?\*/|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'')
    return pattern.sub(lambda m: re.sub(r"[^\n]", " ", m.group()), text)


def extract_range(source, path, first, last, signature):
    """Return lines first..last (1-based, inclusive) after checking the start and the braces."""
    try:
        lines = source.decode("utf-8").splitlines(keepends=True)
    except UnicodeDecodeError as exc:
        raise ContentError(f"invalid UTF-8 in {path}") from exc
    where = f"{path}:{first}-{last}"
    if first < 1 or last < first or len(lines) < last:
        raise ContentError(f"missing range {where}")
    if lines[first - 1].strip() != signature:
        raise ContentError(f"unexpected start of {where}")
    if not lines[last - 1].strip():
        raise ContentError(f"range {where} ends on a blank line")
    chunk = "".join(lines[first - 1:last])
    code = mask_noncode(chunk)
    depth = 0
    outer_close = None
    for position, char in enumerate(code):
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth < 0:
                raise ContentError(f"unbalanced braces in {where}")
            if depth == 0 and outer_close is None:
                outer_close = position
    if outer_close is None or depth != 0:
        raise ContentError(f"unbalanced braces in {where}")
    return chunk, code[outer_close + 1:].strip()


def _without_spaces(text):
    return re.sub(r"\s+", "", text)


def extract_struct(source, entry):
    path, first, last, signature, name = entry
    chunk, tail = extract_range(source, path, first, last, signature)
    if _without_spaces(tail) != f"__attribute__((__packed__)){name};":
        raise ContentError(f"unexpected end of {path}:{first}-{last}: {tail!r}")
    return f"// {path}:{first}-{last}\n{chunk}"


def extract_plain_type(source, entry):
    path, first, last, signature, name, _ = entry
    chunk, tail = extract_range(source, path, first, last, signature)
    if _without_spaces(tail) != f"{name};":
        raise ContentError(f"unexpected end of {path}:{first}-{last}: {tail!r}")
    return f"// {path}:{first}-{last}\n{chunk}"


def extract_define(source, entry):
    """Return a macro definition: a first line that matches exactly, then continued lines."""
    path, first, last, signature, name = entry
    try:
        lines = source.decode("utf-8").splitlines(keepends=True)
    except UnicodeDecodeError as exc:
        raise ContentError(f"invalid UTF-8 in {path}") from exc
    where = f"{path}:{first}-{last}"
    if first < 1 or last < first or len(lines) < last:
        raise ContentError(f"missing range {where}")
    if lines[first - 1].rstrip("\n") != signature:
        raise ContentError(f"unexpected start of {where}")
    if not signature.startswith(f"#define {name}"):
        raise ContentError(f"{where} does not define {name}")
    for number in range(first, last + 1):
        text = lines[number - 1].rstrip("\n")
        continued = text.endswith("\\")
        if continued != (number < last):
            raise ContentError(f"macro continuation does not match the range {where}")
    return f"// {where}\n{''.join(lines[first - 1:last])}"


def strip_qualifier(first_line, qualifier):
    """Turn `T Class::name(...)` into `T name(...)`; only the declaration line is touched."""
    pattern = re.compile(rf"\b{re.escape(qualifier)}::")
    if len(pattern.findall(first_line)) != 1:
        raise ContentError(f"expected exactly one {qualifier}:: in {first_line.strip()!r}")
    return pattern.sub("", first_line, count=1)


def extract_sender(source, entry):
    path, first, last, signature, qualifier = entry
    chunk, tail = extract_range(source, path, first, last, signature)
    if tail:
        raise ContentError(f"unexpected end of {path}:{first}-{last}: {tail!r}")
    declaration, newline, body = chunk.partition("\n")
    return f"// {path}:{first}-{last}\n{strip_qualifier(declaration, qualifier)}{newline}{body}"


def extract_reader(source, entry):
    """Like extract_sender, but the `em_msg_t::` qualifier stays: readers are shim members."""
    path, first, last, signature, qualifier = entry
    chunk, tail = extract_range(source, path, first, last, signature)
    if tail:
        raise ContentError(f"unexpected end of {path}:{first}-{last}: {tail!r}")
    if len(re.findall(rf"\b{re.escape(qualifier)}::", signature)) != 1:
        raise ContentError(f"expected exactly one {qualifier}:: in {signature!r}")
    return f"// {path}:{first}-{last}\n{chunk}"


def check_shim_declarations(shim_text, header_text):
    """Check the shim's em_msg_t against the pinned class.

    The members must be exactly SHIM_READER_MEMBERS, and every other line must be a method
    declaration that appears in inc/em_msg.h at the pin (ignoring white space).
    """
    match = re.search(r"^struct em_msg_t \{\n(.*?)^\};", shim_text, re.DOTALL | re.MULTILINE)
    if match is None:
        raise ContentError("shim.hpp does not declare struct em_msg_t")
    header_lines = {_without_spaces(line) for line in header_text.splitlines()}
    members = []
    for line in match.group(1).splitlines():
        line = line.strip()
        if not line or line.startswith("//"):
            continue
        if "(" not in line:
            members.append(line)
        elif _without_spaces(line) not in header_lines:
            raise ContentError(f"shim declaration is not in {EM_MSG_H} at the pin: {line!r}")
    if members != SHIM_READER_MEMBERS:
        raise ContentError(f"shim em_msg_t members {members} differ from {SHIM_READER_MEMBERS}")
    for member in members:
        if _without_spaces(member) not in header_lines:
            raise ContentError(f"shim member is not in {EM_MSG_H} at the pin: {member!r}")


def write_extractions(sources, scratch):
    types = sorted([(entry[0], entry[1], extract_struct(sources[entry[0]], entry))
                    for entry in STRUCTS] +
                   [(entry[0], entry[1], extract_plain_type(sources[entry[0]], entry))
                    for entry in PLAIN_TYPES])
    defines = [extract_define(sources[entry[0]], entry) for entry in DEFINES]
    senders = [extract_sender(sources[entry[0]], entry) for entry in SENDERS]
    readers = [extract_reader(sources[entry[0]], entry) for entry in READERS]
    shim_text = (TOOL / "shim.hpp").read_text(encoding="utf-8")
    check_shim_declarations(shim_text, sources[EM_MSG_H].decode("utf-8"))
    # Upstream declares the types in file order, so that order satisfies their dependencies.
    (scratch / "defines.inc").write_text("\n".join(defines), encoding="utf-8")
    (scratch / "structs.inc").write_text("\n".join(text for _, _, text in types), encoding="utf-8")
    (scratch / "senders.inc").write_text("\n".join(senders), encoding="utf-8")
    (scratch / "readers.inc").write_text("\n".join(readers), encoding="utf-8")
    for name in ("shim.hpp", "vectors.cpp"):
        (scratch / name).write_bytes((TOOL / name).read_bytes())


def compile_and_run(scratch, cxx):
    """Compile vectors.cpp in scratch and run it.

    Returns (sender body, reader body, compiler version, flags), the bodies as bytes.
    """
    env = os.environ.copy()
    env["CCACHE_DISABLE"] = "1"  # some build environments have a read-only ccache directory
    cxxflags = ["-std=c++17", "-O2"]
    lines = run([cxx, "--version"], env=env).decode("utf-8", "replace").splitlines()
    if not lines:
        raise ToolError(f"compiler {cxx} did not report a version")
    run([cxx, *cxxflags, "vectors.cpp", "-o", "vectors"], cwd=scratch, env=env)
    sender_path = scratch / "senders.tsv"
    reader_path = scratch / "readers.tsv"
    run([str(scratch / "vectors"), str(sender_path), str(reader_path)], cwd=scratch, env=env)
    return sender_path.read_bytes(), reader_path.read_bytes(), lines[0], cxxflags


def parse_probe(body):
    """Return {struct: {member: value}} from the `# Probe:` lines of the harness output."""
    probes = {}
    for line in body.decode("ascii", "replace").splitlines():
        if not line.startswith("# Probe:"):
            continue
        if not line.startswith(PROBE_PREFIX):
            raise ToolError(f"malformed probe line {line!r}")
        parts = line[len(PROBE_PREFIX):].split()
        if len(parts) < 2 or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", parts[0]):
            raise ToolError(f"malformed probe line {line!r}")
        name, *items = parts
        if name in probes:
            raise ToolError(f"duplicate probe for {name}")
        values = {}
        has_sizeof = False
        for item in items:
            key, separator, value = item.partition("=")
            member = re.fullmatch(r"offsetof\(([A-Za-z_][A-Za-z0-9_]*)\)", key)
            if member:
                key = member.group(1)
            if (not separator or (not member and key != "sizeof")
                    or not re.fullmatch(r"[0-9]+", value) or key in values):
                raise ToolError(f"malformed probe item {item!r} for {name}")
            try:
                values[key] = int(value)
            except ValueError as exc:
                raise ToolError(f"malformed probe item {item!r} for {name}") from exc
            if not member and key == "sizeof":
                has_sizeof = True
        if not has_sizeof:
            raise ToolError(f"missing sizeof in probe for {name}")
        probes[name] = values
    return probes


def check_probe(body):
